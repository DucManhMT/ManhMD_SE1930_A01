<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FUNews</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-fu">
            <div class="container fu-container-public">
                <a class="navbar-brand navbar-brand-fu" asp-controller="Home" asp-action="Index">FUNews</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain"
                        aria-expanded="false" aria-label="Chuyển đổi điều hướng">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Tin tức</a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center">
                        <a class="btn btn-outline-primary btn-sm me-2" href="/search">Tìm kiếm</a>
                        <a class="btn btn-fu-primary btn-sm" href="/login">Đăng nhập</a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container fu-container-public flex-grow-1 my-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Toast container cho thông báo toàn hệ thống -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3" id="fuToastContainer"></div>

    <footer class="footer-fu">
        <div class="container fu-container-public text-center">
            &copy; 2026 - FUNews Management System - ManhMD (SE1930) - PRN232 Assignment 01
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
