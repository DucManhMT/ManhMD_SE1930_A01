@page "/search"
@model ManhMD_SE1930_A01_FE.Pages.SearchModel
@{
    ViewData["Title"] = "Tìm kiếm bài viết nâng cao";
}

<div class="container py-3 fu-container-public">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4 pb-2 border-bottom">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb small mb-1">
                    <li class="breadcrumb-item"><a asp-page="/Index" class="text-decoration-none">Trang chủ</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Tìm kiếm nâng cao</li>
                </ol>
            </nav>
            <h1 class="h3 fw-bold text-dark mb-0">
                <i class="bi bi-search text-primary me-2"></i>Tìm kiếm bài viết tin tức
            </h1>
            <p class="text-muted small mb-0 mt-1">
                Tìm kiếm thông minh kết hợp từ khóa, chuyên mục, thẻ tin, tác giả và khoảng thời gian.
            </p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 fw-semibold">
                <i class="bi bi-funnel me-1"></i>Bộ lọc nâng cao
            </span>
            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3 py-2 fw-semibold">
                Tìm thấy: @Model.TotalCount kết quả
            </span>
        </div>
    </div>

    <!-- Thông báo lỗi (nếu có) -->
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-warning alert-dismissible fade show d-flex align-items-center shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5 me-2 flex-shrink-0"></i>
            <div>@Model.ErrorMessage</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Form tìm kiếm nâng cao -->
    <div class="card card-fu shadow-sm mb-4">
        <div class="card-header bg-light py-2 px-3 border-bottom d-flex align-items-center">
            <span class="fw-semibold text-secondary small">
                <i class="bi bi-sliders me-1"></i>Điều kiện tìm kiếm
            </span>
        </div>
        <div class="card-body p-3 p-md-4">
            <form method="get" id="formAdvancedSearch">
                <!-- Dòng 1: Từ khóa, Tác giả, Chuyên mục, Thẻ tin -->
                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-4">
                        <label for="inputSearchTerm" class="form-label small fw-semibold text-secondary mb-1">
                            <i class="bi bi-type me-1"></i>Từ khóa tìm kiếm
                        </label>
                        <input type="text" class="form-control form-control-sm" id="inputSearchTerm" name="searchTerm"
                               placeholder="Tìm theo tiêu đề, tóm tắt, nội dung..." value="@Model.SearchTerm" maxlength="200" />
                    </div>

                    <div class="col-12 col-sm-6 col-md-3">
                        <label for="inputAuthor" class="form-label small fw-semibold text-secondary mb-1">
                            <i class="bi bi-person me-1"></i>Tác giả bài viết
                        </label>
                        <input type="text" class="form-control form-control-sm" id="inputAuthor" name="authorTerm"
                               placeholder="Tên tác giả..." value="@Model.AuthorTerm" maxlength="100" />
                    </div>

                    <div class="col-12 col-sm-6 col-md-2">
                        <label for="selectCategory" class="form-label small fw-semibold text-secondary mb-1">
                            <i class="bi bi-folder2 me-1"></i>Chuyên mục
                        </label>
                        <select class="form-select form-select-sm" id="selectCategory" name="categoryId">
                            <option value="">-- Tất cả --</option>
                            @foreach (var cat in Model.Categories)
                            {
                                if (Model.CategoryId.HasValue && Model.CategoryId.Value == cat.CategoryId)
                                {
                                    <option value="@cat.CategoryId" selected>@cat.CategoryName</option>
                                }
                                else
                                {
                                    <option value="@cat.CategoryId">@cat.CategoryName</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-12 col-sm-6 col-md-3">
                        <label for="selectTag" class="form-label small fw-semibold text-secondary mb-1">
                            <i class="bi bi-tags me-1"></i>Thẻ tin (Tag)
                        </label>
                        <select class="form-select form-select-sm" id="selectTag" name="tagId">
                            <option value="">-- Tất cả --</option>
                            @foreach (var tag in Model.Tags)
                            {
                                if (Model.TagId.HasValue && Model.TagId.Value == tag.TagId)
                                {
                                    <option value="@tag.TagId" selected>@tag.TagName</option>
                                }
                                else
                                {
                                    <option value="@tag.TagId">@tag.TagName</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <!-- Dòng 2: Khoảng ngày, Trạng thái (Staff), Sắp xếp, Số dòng -->
                <div class="row g-3 align-items-end">
                    <div class="col-12 col-sm-6 col-md-3">
                        <label for="inputStartDate" class="form-label small fw-semibold text-secondary mb-1">
                            <i class="bi bi-calendar-event me-1"></i>Từ ngày
                        </label>
                        <input type="date" class="form-control form-control-sm" id="inputStartDate" name="startDate"
                               value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" />
                    </div>

                    <div class="col-12 col-sm-6 col-md-3">
                        <label for="inputEndDate" class="form-label small fw-semibold text-secondary mb-1">
                            <i class="bi bi-calendar-check me-1"></i>Đến ngày
                        </label>
                        <input type="date" class="form-control form-control-sm" id="inputEndDate" name="endDate"
                               value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" />
                    </div>

                    @if (Model.IsStaff)
                    {
                        <div class="col-12 col-sm-6 col-md-2">
                            <label for="selectStatus" class="form-label small fw-semibold text-secondary mb-1">
                                <i class="bi bi-shield-check me-1"></i>Trạng thái
                            </label>
                            <select class="form-select form-select-sm" id="selectStatus" name="statusFilter">
                                <option value="" selected="@(string.IsNullOrEmpty(Model.StatusFilter))">Tất cả</option>
                                <option value="active" selected="@(Model.StatusFilter?.ToLowerInvariant() == "active")">Đang hiển thị</option>
                                <option value="inactive" selected="@(Model.StatusFilter?.ToLowerInvariant() == "inactive")">Tạm ẩn</option>
                            </select>
                        </div>
                    }

                    <div class="col-12 col-sm-6 @(Model.IsStaff ? "col-md-2" : "col-md-3")">
                        <label for="selectSort" class="form-label small fw-semibold text-secondary mb-1">
                            <i class="bi bi-arrow-down-up me-1"></i>Sắp xếp
                        </label>
                        <select class="form-select form-select-sm" id="selectSort" name="sortBy">
                            <option value="date_desc" selected="@(string.IsNullOrEmpty(Model.SortBy) || Model.SortBy == "date_desc")">Mới nhất trước</option>
                            <option value="date_asc" selected="@(Model.SortBy == "date_asc")">Cũ nhất trước</option>
                            <option value="title_asc" selected="@(Model.SortBy == "title_asc")">Tiêu đề (A - Z)</option>
                            <option value="title_desc" selected="@(Model.SortBy == "title_desc")">Tiêu đề (Z - A)</option>
                        </select>
                    </div>

                    <div class="col-12 col-sm-6 @(Model.IsStaff ? "col-md-2" : "col-md-3") d-flex gap-2">
                        <button type="submit" class="btn btn-fu-primary btn-sm flex-fill" id="btnSearchSubmit">
                            <i class="bi bi-search me-1"></i>Tìm kiếm
                        </button>
                        <a asp-page="/Search" class="btn btn-outline-secondary btn-sm" title="Đặt lại bộ lọc">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Kết quả tìm kiếm -->
    @if (Model.NewsArticles.Count == 0)
    {
        <div class="card card-fu shadow-sm p-5 text-center my-4">
            <div class="py-4">
                <i class="bi bi-search-heart text-muted display-4 d-block mb-3"></i>
                <h3 class="h5 fw-bold text-secondary mb-2">Không tìm thấy bài viết nào phù hợp</h3>
                <p class="text-muted small mb-3">
                    Vui lòng thử lại với từ khóa khác, thay đổi khoảng thời gian hoặc bỏ bớt các điều kiện lọc.
                </p>
                <a asp-page="/Search" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-arrow-counterclockwise me-1"></i>Xóa bộ lọc
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4 mb-4">
            @foreach (var article in Model.NewsArticles)
            {
                <div class="col-12">
                    <div class="card card-fu shadow-sm h-100 p-3 p-md-4">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                @if (!string.IsNullOrWhiteSpace(article.CategoryName))
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-medium">
                                        <i class="bi bi-folder2 me-1"></i>@article.CategoryName
                                    </span>
                                }
                                <span class="text-muted small">
                                    <i class="bi bi-calendar3 me-1"></i>@(article.CreatedDate?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")
                                </span>
                                @if (!string.IsNullOrWhiteSpace(article.AuthorName))
                                {
                                    <span class="text-muted small">
                                        <i class="bi bi-person me-1"></i>@article.AuthorName
                                    </span>
                                }
                            </div>
                            @if (Model.IsStaff)
                            {
                                if (article.NewsStatus == true)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                        <i class="bi bi-check-circle me-1"></i>Đang hiển thị
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                                        <i class="bi bi-eye-slash me-1"></i>Tạm ẩn
                                    </span>
                                }
                            }
                        </div>

                        <h2 class="h5 fw-bold mb-2">
                            <a asp-page="/News/Detail" asp-route-id="@article.NewsArticleId" class="text-dark text-decoration-none hover-primary">
                                @article.NewsTitle
                            </a>
                        </h2>

                        <p class="text-muted small mb-3">
                            @article.Headline
                        </p>

                        @if (article.Tags != null && article.Tags.Count > 0)
                        {
                            <div class="d-flex flex-wrap gap-1 mb-3">
                                @foreach (var tag in article.Tags)
                                {
                                    <a asp-page="/Search" asp-route-tagId="@tag.TagId" class="badge bg-light text-secondary border text-decoration-none">
                                        #@tag.TagName
                                    </a>
                                }
                            </div>
                        }

                        <div class="d-flex justify-content-between align-items-center pt-2 border-top mt-auto">
                            <span class="text-muted small">
                                Mã: <code class="text-secondary">@article.NewsArticleId</code>
                            </span>
                            <a asp-page="/News/Detail" asp-route-id="@article.NewsArticleId" class="btn btn-outline-primary btn-sm">
                                Xem chi tiết <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Phân trang - Bảo toàn tất cả query parameters (AC 3) -->
        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Phân trang kết quả tìm kiếm" class="d-flex justify-content-center my-4">
                <ul class="pagination pagination-sm">
                    <!-- Nút Trang trước -->
                    <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                        <a class="page-link" asp-page="/Search"
                           asp-route-searchTerm="@Model.SearchTerm"
                           asp-route-categoryId="@Model.CategoryId"
                           asp-route-tagId="@Model.TagId"
                           asp-route-authorTerm="@Model.AuthorTerm"
                           asp-route-startDate="@(Model.StartDate?.ToString("yyyy-MM-dd"))"
                           asp-route-endDate="@(Model.EndDate?.ToString("yyyy-MM-dd"))"
                           asp-route-statusFilter="@Model.StatusFilter"
                           asp-route-sortBy="@Model.SortBy"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-pageIndex="@(Model.PageIndex - 1)">
                            <i class="bi bi-chevron-left"></i> Trước
                        </a>
                    </li>

                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.PageIndex ? "active" : "")">
                            <a class="page-link" asp-page="/Search"
                               asp-route-searchTerm="@Model.SearchTerm"
                               asp-route-categoryId="@Model.CategoryId"
                               asp-route-tagId="@Model.TagId"
                               asp-route-authorTerm="@Model.AuthorTerm"
                               asp-route-startDate="@(Model.StartDate?.ToString("yyyy-MM-dd"))"
                               asp-route-endDate="@(Model.EndDate?.ToString("yyyy-MM-dd"))"
                               asp-route-statusFilter="@Model.StatusFilter"
                               asp-route-sortBy="@Model.SortBy"
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-pageIndex="@p">@p</a>
                        </li>
                    }

                    <!-- Nút Trang sau -->
                    <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                        <a class="page-link" asp-page="/Search"
                           asp-route-searchTerm="@Model.SearchTerm"
                           asp-route-categoryId="@Model.CategoryId"
                           asp-route-tagId="@Model.TagId"
                           asp-route-authorTerm="@Model.AuthorTerm"
                           asp-route-startDate="@(Model.StartDate?.ToString("yyyy-MM-dd"))"
                           asp-route-endDate="@(Model.EndDate?.ToString("yyyy-MM-dd"))"
                           asp-route-statusFilter="@Model.StatusFilter"
                           asp-route-sortBy="@Model.SortBy"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-pageIndex="@(Model.PageIndex + 1)">
                            Sau <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>
