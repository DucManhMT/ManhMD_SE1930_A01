@page "/admin/accounts"
@model ManhMD_SE1930_A01_FE.Pages.Admin.AccountsModel
@{
    ViewData["Title"] = "Quản lý tài khoản";
}

<div class="container fu-container-public py-4">
    <!-- Breadcrumb & Header -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-1">
            <li class="breadcrumb-item"><a asp-page="/Index" class="text-decoration-none">Trang chủ</a></li>
            <li class="breadcrumb-item active" aria-current="page">Quản trị hệ thống</li>
            <li class="breadcrumb-item active" aria-current="page">Quản lý tài khoản</li>
        </ol>
    </nav>

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom gap-2">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-people-fill text-primary me-2"></i>Quản lý tài khoản người dùng
            </h1>
            <p class="text-muted small mb-0">Theo dõi, tìm kiếm và tạo mới tài khoản quản lý và giảng viên</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-secondary px-3 py-2 fs-6">
                Tổng số: <span id="badgeTotalCount">@Model.TotalCount</span> tài khoản
            </span>
            <button type="button" class="btn btn-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#modalCreateAccount" id="btnOpenCreateModal">
                <i class="bi bi-person-plus-fill me-1"></i>Thêm tài khoản
            </button>
        </div>
    </div>

    <!-- Alert Messages (nếu có lỗi tải trang) -->
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search & Filter Card -->
    <div class="card card-fu shadow-sm mb-4">
        <div class="card-body p-3">
            <form method="get" id="formAccountFilter" class="row g-2 align-items-end">
                <div class="col-md-6 col-lg-5">
                    <label for="inputSearchTerm" class="form-label small fw-semibold text-muted mb-1">Tìm kiếm</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" id="inputSearchTerm" name="searchTerm" value="@Model.SearchTerm" class="form-control border-start-0" placeholder="Nhập tên hoặc email cần tìm..." />
                    </div>
                </div>
                <div class="col-md-4 col-lg-3">
                    <label for="selectRoleFilter" class="form-label small fw-semibold text-muted mb-1">Lọc vai trò</label>
                    <select id="selectRoleFilter" name="roleFilter" class="form-select">
                        <option value="">-- Tất cả vai trò --</option>
                        <option value="1" selected="@(Model.RoleFilter == 1)">Nhân viên (Staff)</option>
                        <option value="2" selected="@(Model.RoleFilter == 2)">Giảng viên (Lecturer)</option>
                    </select>
                </div>
                <div class="col-md-2 col-lg-4 d-flex gap-2">
                    <button type="submit" class="btn btn-outline-primary" id="btnFilterSubmit">
                        <i class="bi bi-funnel me-1"></i>Lọc
                    </button>
                    @if (!string.IsNullOrWhiteSpace(Model.SearchTerm) || Model.RoleFilter.HasValue)
                    {
                        <a asp-page="/Admin/Accounts" class="btn btn-outline-secondary" id="btnResetFilter" title="Xóa bộ lọc">
                            <i class="bi bi-x-circle me-1"></i>Xóa lọc
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Accounts Table Card -->
    <div class="card card-fu shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="tableAccounts">
                <thead class="table-light">
                    <tr>
                        <th scope="col" style="width: 80px;" class="text-center">Mã ID</th>
                        <th scope="col">Họ và tên</th>
                        <th scope="col">Email đăng nhập</th>
                        <th scope="col" style="width: 170px;">Vai trò</th>
                        <th scope="col" style="width: 140px;" class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody id="tableAccountsBody">
                    @if (Model.Accounts.Any())
                    {
                        @foreach (var account in Model.Accounts)
                        {
                            <tr id="row-account-@account.AccountId" data-account-id="@account.AccountId" data-account-email="@account.AccountEmail">
                                <td class="text-center fw-semibold text-muted">@account.AccountId</td>
                                <td>
                                    <div class="fw-bold text-dark">@account.AccountName</div>
                                </td>
                                <td>
                                    <span class="text-body font-monospace small">@account.AccountEmail</span>
                                </td>
                                <td>
                                    @if (account.AccountRole == 1)
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                                            <i class="bi bi-person-badge me-1"></i>Nhân viên
                                        </span>
                                    }
                                    else if (account.AccountRole == 2)
                                    {
                                        <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle px-2 py-1">
                                            <i class="bi bi-mortarboard me-1"></i>Giảng viên
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border px-2 py-1">
                                            @(account.RoleName ?? "Không xác định")
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <button type="button" class="btn btn-outline-secondary btn-sm" disabled title="Chức năng chỉnh sửa thuộc task [FUN-006]">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button type="button" class="btn btn-outline-danger btn-sm" disabled title="Chức năng xóa thuộc task [FUN-006]">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr id="rowEmptyAccounts">
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                <span>Không tìm thấy tài khoản nào phù hợp với điều kiện tìm kiếm.</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Thêm tài khoản mới (AJAX) -->
<div class="modal fade" id="modalCreateAccount" tabindex="-1" aria-labelledby="modalCreateAccountLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow">
            <div class="modal-header bg-primary text-white py-3">
                <h5 class="modal-title h6 fw-bold mb-0" id="modalCreateAccountLabel">
                    <i class="bi bi-person-plus-fill me-2"></i>Thêm tài khoản người dùng mới
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" id="btnCloseCreateModal"></button>
            </div>
            <form id="formCreateAccount" novalidate>
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <!-- Alert thông báo lỗi tổng quan -->
                    <div class="alert alert-danger d-none py-2 mb-3" id="createAccountAlert" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <span id="createAccountAlertText"></span>
                    </div>

                    <!-- Họ và tên -->
                    <div class="mb-3">
                        <label for="createAccountName" class="form-label fw-semibold small">
                            Họ và tên <span class="text-danger">*</span>
                        </label>
                        <input type="text" class="form-control" id="createAccountName" name="accountName" placeholder="Ví dụ: Nguyễn Văn A" maxlength="100" required />
                        <div class="invalid-feedback" id="errorAccountName">Họ và tên là bắt buộc (tối đa 100 ký tự).</div>
                    </div>

                    <!-- Email -->
                    <div class="mb-3">
                        <label for="createAccountEmail" class="form-label fw-semibold small">
                            Địa chỉ Email <span class="text-danger">*</span>
                        </label>
                        <input type="email" class="form-control" id="createAccountEmail" name="accountEmail" placeholder="example@funews.edu.vn" maxlength="70" required />
                        <div class="invalid-feedback" id="errorAccountEmail">Email là bắt buộc và phải đúng định dạng.</div>
                    </div>

                    <!-- Vai trò -->
                    <div class="mb-3">
                        <label for="createAccountRole" class="form-label fw-semibold small">
                            Vai trò hệ thống <span class="text-danger">*</span>
                        </label>
                        <select class="form-select" id="createAccountRole" name="accountRole" required>
                            <option value="">-- Chọn vai trò người dùng --</option>
                            <option value="1">Nhân viên quản lý tin (Staff)</option>
                            <option value="2">Giảng viên xem tin (Lecturer)</option>
                        </select>
                        <div class="invalid-feedback" id="errorAccountRole">Vui lòng chọn vai trò hợp lệ (Nhân viên hoặc Giảng viên).</div>
                    </div>

                    <!-- Mật khẩu khởi tạo -->
                    <div class="mb-2">
                        <label for="createAccountPassword" class="form-label fw-semibold small">
                            Mật khẩu khởi tạo <span class="text-danger">*</span>
                        </label>
                        <input type="password" class="form-control" id="createAccountPassword" name="accountPassword" placeholder="Nhập mật khẩu (tối thiểu 6 ký tự)" minlength="6" maxlength="100" required autocomplete="new-password" />
                        <div class="form-text text-muted small">Mật khẩu ban đầu để người dùng đăng nhập vào hệ thống.</div>
                        <div class="invalid-feedback" id="errorAccountPassword">Mật khẩu là bắt buộc và có độ dài từ 6 đến 100 ký tự.</div>
                    </div>
                </div>

                <div class="modal-footer bg-light py-2 px-4">
                    <button type="button" class="btn btn-outline-secondary btn-sm px-3" data-bs-dismiss="modal" id="btnCancelCreateModal">Hủy</button>
                    <button type="submit" class="btn btn-primary btn-sm px-4" id="btnSubmitCreateAccount">
                        <span class="spinner-border spinner-border-sm me-1 d-none" id="spinnerCreateAccount" role="status" aria-hidden="true"></span>
                        <span id="btnTextCreateAccount">Lưu tài khoản</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Toast thông báo thành công -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1080;">
    <div id="accountToast" class="toast align-items-center text-white bg-success border-0 shadow" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body">
                <i class="bi bi-check-circle-fill me-2 fs-6"></i>
                <span id="accountToastMsg">Thao tác thành công.</span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const formCreate = document.getElementById('formCreateAccount');
            const modalEl = document.getElementById('modalCreateAccount');
            const modalInstance = modalEl ? new bootstrap.Modal(modalEl) : null;

            const nameInput = document.getElementById('createAccountName');
            const emailInput = document.getElementById('createAccountEmail');
            const roleSelect = document.getElementById('createAccountRole');
            const passwordInput = document.getElementById('createAccountPassword');

            const alertBox = document.getElementById('createAccountAlert');
            const alertText = document.getElementById('createAccountAlertText');
            const submitBtn = document.getElementById('btnSubmitCreateAccount');
            const spinner = document.getElementById('spinnerCreateAccount');
            const btnText = document.getElementById('btnTextCreateAccount');

            const toastEl = document.getElementById('accountToast');
            const toastMsg = document.getElementById('accountToastMsg');
            const toastInstance = toastEl ? new bootstrap.Toast(toastEl, { delay: 4000 }) : null;

            // Xóa trạng thái validate khi mở modal
            modalEl?.addEventListener('show.bs.modal', function () {
                resetFormValidation();
                formCreate?.reset();
            });

            // Lấy danh sách email hiện có trên bảng để chặn email trùng ngay tại client
            function getExistingEmails() {
                const emails = new Set();
                document.querySelectorAll('#tableAccountsBody tr[data-account-email]').forEach(row => {
                    const em = row.getAttribute('data-account-email');
                    if (em) emails.add(em.trim().toLowerCase());
                });
                return emails;
            }

            // Kiểm tra email trùng khi rời input email
            emailInput?.addEventListener('blur', function () {
                const emailVal = emailInput.value.trim().toLowerCase();
                if (!emailVal) return;

                const existing = getExistingEmails();
                if (existing.has(emailVal)) {
                    setFieldError(emailInput, 'errorAccountEmail', 'Email này đã tồn tại trong danh sách tài khoản hệ thống.');
                } else if (emailInput.validity.typeMismatch) {
                    setFieldError(emailInput, 'errorAccountEmail', 'Địa chỉ email không đúng định dạng.');
                } else {
                    clearFieldError(emailInput, 'errorAccountEmail');
                }
            });

            // Xóa lỗi khi gõ
            nameInput?.addEventListener('input', () => clearFieldError(nameInput, 'errorAccountName'));
            emailInput?.addEventListener('input', () => clearFieldError(emailInput, 'errorAccountEmail'));
            roleSelect?.addEventListener('change', () => clearFieldError(roleSelect, 'errorAccountRole'));
            passwordInput?.addEventListener('input', () => clearFieldError(passwordInput, 'errorAccountPassword'));

            function setFieldError(inputEl, errorDivId, message) {
                if (inputEl) inputEl.classList.add('is-invalid');
                const errDiv = document.getElementById(errorDivId);
                if (errDiv) errDiv.textContent = message;
            }

            function clearFieldError(inputEl, errorDivId) {
                if (inputEl) inputEl.classList.remove('is-invalid');
            }

            function resetFormValidation() {
                [nameInput, emailInput, roleSelect, passwordInput].forEach(inp => {
                    if (inp) inp.classList.remove('is-invalid');
                });
                if (alertBox) alertBox.classList.add('d-none');
            }

            // Client-side validation
            function validateClientForm() {
                let isValid = true;
                let firstInvalid = null;

                const nameVal = nameInput?.value.trim();
                if (!nameVal) {
                    setFieldError(nameInput, 'errorAccountName', 'Họ và tên là bắt buộc.');
                    isValid = false;
                    if (!firstInvalid) firstInvalid = nameInput;
                } else if (nameVal.length > 100) {
                    setFieldError(nameInput, 'errorAccountName', 'Họ và tên không được vượt quá 100 ký tự.');
                    isValid = false;
                    if (!firstInvalid) firstInvalid = nameInput;
                }

                const emailVal = emailInput?.value.trim().toLowerCase();
                const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
                if (!emailVal) {
                    setFieldError(emailInput, 'errorAccountEmail', 'Email là bắt buộc.');
                    isValid = false;
                    if (!firstInvalid) firstInvalid = emailInput;
                } else if (!emailRegex.test(emailVal) || emailVal.length > 70) {
                    setFieldError(emailInput, 'errorAccountEmail', 'Email không đúng định dạng hoặc vượt quá 70 ký tự.');
                    isValid = false;
                    if (!firstInvalid) firstInvalid = emailInput;
                } else {
                    // Acceptance Criteria 1: Email trùng bị chặn client
                    const existing = getExistingEmails();
                    if (existing.has(emailVal)) {
                        setFieldError(emailInput, 'errorAccountEmail', 'Email này đã tồn tại trong danh sách tài khoản hệ thống.');
                        isValid = false;
                        if (!firstInvalid) firstInvalid = emailInput;
                    }
                }

                const roleVal = roleSelect?.value;
                // Acceptance Criteria 5: Role ngoài 1/2 bị từ chối
                if (!roleVal || (roleVal !== '1' && roleVal !== '2')) {
                    setFieldError(roleSelect, 'errorAccountRole', 'Vui lòng chọn vai trò: Nhân viên (1) hoặc Giảng viên (2).');
                    isValid = false;
                    if (!firstInvalid) firstInvalid = roleSelect;
                }

                const passVal = passwordInput?.value;
                if (!passVal || passVal.length < 6) {
                    setFieldError(passwordInput, 'errorAccountPassword', 'Mật khẩu phải có độ dài tối thiểu 6 ký tự.');
                    isValid = false;
                    if (!firstInvalid) firstInvalid = passwordInput;
                }

                if (!isValid && firstInvalid) {
                    firstInvalid.focus();
                }

                return isValid;
            }

            // AJAX Form Submit
            formCreate?.addEventListener('submit', async function (e) {
                e.preventDefault();
                resetFormValidation();

                if (!validateClientForm()) {
                    return;
                }

                // Lấy Anti-Forgery token
                const csrfTokenInput = formCreate.querySelector('input[name="__RequestVerificationToken"]');
                const csrfToken = csrfTokenInput ? csrfTokenInput.value : '';

                const payload = {
                    accountName: nameInput.value.trim(),
                    accountEmail: emailInput.value.trim(),
                    accountRole: parseInt(roleSelect.value, 10),
                    accountPassword: passwordInput.value
                };

                // Bật loading
                if (submitBtn) submitBtn.disabled = true;
                if (spinner) spinner.classList.remove('d-none');
                if (btnText) btnText.textContent = 'Đang lưu...';

                try {
                    const response = await fetch('/admin/accounts?handler=Create', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-CSRF-TOKEN': csrfToken
                        },
                        body: JSON.stringify(payload)
                    });

                    const result = await response.json();

                    if (result && result.success) {
                        // Acceptance Criteria 4: Tạo thành công cập nhật AJAX không full reload
                        modalInstance?.hide();
                        formCreate.reset();

                        // Hiển thị Toast
                        if (toastMsg) toastMsg.textContent = result.message || 'Tạo tài khoản thành công!';
                        toastInstance?.show();

                        // Cập nhật DOM bảng bằng AJAX
                        insertAccountRow(result.account);

                        // Cập nhật tổng số
                        const badgeTotal = document.getElementById('badgeTotalCount');
                        if (badgeTotal) {
                            const curTotal = parseInt(badgeTotal.textContent, 10) || 0;
                            badgeTotal.textContent = (curTotal + 1).toString();
                        }
                    } else {
                        // Thất bại: GIỮ NGUYÊN FORM VÀ GIÁ TRỊ NHẬP LIỆU (không đóng modal)
                        if (alertBox && alertText) {
                            alertText.textContent = result.message || 'Không thể tạo tài khoản. Vui lòng kiểm tra lại.';
                            alertBox.classList.remove('d-none');
                        }

                        // Hiển thị field-level validation errors từ server ProblemDetails
                        if (result.errors) {
                            let firstErr = null;
                            if (result.errors.AccountEmail || result.errors.accountEmail) {
                                const msg = (result.errors.AccountEmail || result.errors.accountEmail)[0];
                                setFieldError(emailInput, 'errorAccountEmail', msg);
                                if (!firstErr) firstErr = emailInput;
                            }
                            if (result.errors.AccountName || result.errors.accountName) {
                                const msg = (result.errors.AccountName || result.errors.accountName)[0];
                                setFieldError(nameInput, 'errorAccountName', msg);
                                if (!firstErr) firstErr = nameInput;
                            }
                            if (result.errors.AccountRole || result.errors.accountRole) {
                                const msg = (result.errors.AccountRole || result.errors.accountRole)[0];
                                setFieldError(roleSelect, 'errorAccountRole', msg);
                                if (!firstErr) firstErr = roleSelect;
                            }
                            if (result.errors.AccountPassword || result.errors.accountPassword) {
                                const msg = (result.errors.AccountPassword || result.errors.accountPassword)[0];
                                setFieldError(passwordInput, 'errorAccountPassword', msg);
                                if (!firstErr) firstErr = passwordInput;
                            }

                            if (firstErr) firstErr.focus();
                        }
                    }
                } catch (err) {
                    if (alertBox && alertText) {
                        alertText.textContent = 'Lỗi kết nối máy chủ. Vui lòng thử lại sau.';
                        alertBox.classList.remove('d-none');
                    }
                } finally {
                    if (submitBtn) submitBtn.disabled = false;
                    if (spinner) spinner.classList.add('d-none');
                    if (btnText) btnText.textContent = 'Lưu tài khoản';
                }
            });

            // Chèn dòng tài khoản mới vào bảng
            function insertAccountRow(acc) {
                if (!acc) return;
                const tbody = document.getElementById('tableAccountsBody');
                if (!tbody) return;

                // Xóa hàng empty nếu có
                const emptyRow = document.getElementById('rowEmptyAccounts');
                if (emptyRow) emptyRow.remove();

                const roleBadge = acc.accountRole === 1
                    ? `<span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1"><i class="bi bi-person-badge me-1"></i>Nhân viên</span>`
                    : acc.accountRole === 2
                    ? `<span class="badge bg-info-subtle text-info-emphasis border border-info-subtle px-2 py-1"><i class="bi bi-mortarboard me-1"></i>Giảng viên</span>`
                    : `<span class="badge bg-secondary-subtle text-secondary border px-2 py-1">${escapeHtml(acc.roleName || 'Không xác định')}</span>`;

                const tr = document.createElement('tr');
                tr.id = `row-account-${acc.accountId}`;
                tr.setAttribute('data-account-id', acc.accountId);
                tr.setAttribute('data-account-email', acc.accountEmail);
                tr.className = 'table-success-subtle transition-all';

                tr.innerHTML = `
                    <td class="text-center fw-semibold text-muted">${acc.accountId}</td>
                    <td><div class="fw-bold text-dark">${escapeHtml(acc.accountName)}</div></td>
                    <td><span class="text-body font-monospace small">${escapeHtml(acc.accountEmail)}</span></td>
                    <td>${roleBadge}</td>
                    <td class="text-center">
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button" class="btn btn-outline-secondary btn-sm" disabled title="Chức năng chỉnh sửa thuộc task [FUN-006]">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button type="button" class="btn btn-outline-danger btn-sm" disabled title="Chức năng xóa thuộc task [FUN-006]">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </td>
                `;

                // Thêm vào đầu bảng
                tbody.prepend(tr);

                // Highlight animation
                setTimeout(() => {
                    tr.classList.remove('table-success-subtle');
                }, 2000);
            }

            function escapeHtml(text) {
                if (!text) return '';
                const map = {
                    '&': '&amp;',
                    '<': '&lt;',
                    '>': '&gt;',
                    '"': '&quot;',
                    "'": '&#039;'
                };
                return text.toString().replace(/[&<>"']/g, m => map[m]);
            }
        });
    </script>
}
