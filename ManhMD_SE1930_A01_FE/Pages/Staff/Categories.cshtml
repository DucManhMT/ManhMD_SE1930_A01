@page "/staff/categories"
@model ManhMD_SE1930_A01_FE.Pages.Staff.CategoriesModel
@{
    ViewData["Title"] = "Quản lý chuyên mục";
}

<div class="container fu-container-public">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">Quản lý chuyên mục tin tức</h1>
            <p class="text-muted small mb-0">Nhân viên tạo, quản lý và cấu hình trạng thái chuyên mục</p>
        </div>
        <span class="badge bg-primary fs-6 px-3 py-2">Staff Only</span>
    </div>

    <div class="card card-fu shadow-sm p-4 text-center my-4">
        <div class="py-4">
            <h2 class="h5 fw-bold text-primary mb-2">Chức năng Quản lý chuyên mục</h2>
            <p class="text-muted mb-3">Màn hình danh sách chuyên mục, đếm số bài, modal thêm/sửa đang được phát triển trong task <strong>[FUN-008]</strong>.</p>
            <a asp-page="/Index" class="btn btn-outline-primary btn-sm">Quay về trang tin tức</a>
        </div>
    </div>
</div>
