                <input type="hidden" id="editTagId" name="tagId" />
                <div class="modal-body p-4">
                    <!-- Alert thông báo lỗi tổng quan -->
                    <div class="alert alert-danger d-none py-2 mb-3" id="editTagAlert" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <span id="editTagAlertText"></span>
                    </div>

                    <!-- Tên thẻ tin (TagName) -->
                    <div class="mb-3">
                        <label for="editTagName" class="form-label fw-semibold small">
                            Tên thẻ tin (Tag Name) <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted">#</span>
                            <input type="text" class="form-control" id="editTagName" name="tagName"
                                   placeholder="Ví dụ: AI, CongNghe, PRN232" maxlength="50" required />
                        </div>
                        <div class="form-text text-muted small text-end"><span id="editTagNameCount">0</span>/50 ký tự</div>
                        <div class="invalid-feedback d-block d-none" id="errorEditTagName">Tên thẻ tin là bắt buộc (tối đa 50 ký tự).</div>
                    </div>

                    <!-- Ghi chú thẻ tin (Note) -->
                    <div class="mb-3">
                        <label for="editTagNote" class="form-label fw-semibold small">
                            Ghi chú (Note) <span class="text-muted">(Tùy chọn)</span>
                        </label>
                        <textarea class="form-control" id="editTagNote" name="note" rows="3"
