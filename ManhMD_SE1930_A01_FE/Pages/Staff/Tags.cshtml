@page "/staff/tags"
@model ManhMD_SE1930_A01_FE.Pages.Staff.TagsModel
@{
    ViewData["Title"] = "Quản lý thẻ tin tức (Tags)";
}

<div class="container fu-container-public py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-page="/Index" class="text-decoration-none"><i class="bi bi-house-door me-1"></i>Trang chủ</a></li>
            <li class="breadcrumb-item"><span class="text-muted">Quản lý nội dung</span></li>
            <li class="breadcrumb-item active" aria-current="page">Thẻ tin tức</li>
        </ol>
    </nav>

    <!-- Header Section -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-3 border-bottom">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-tags-fill text-primary me-2"></i>Quản lý thẻ tin tức (Tags)
            </h1>
            <p class="text-muted small mb-0">Quản lý các từ khóa/thẻ gắn vào bài viết để phân loại nội dung tin tức cho độc giả</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 fw-medium">
                <i class="bi bi-shield-lock-fill me-1"></i>Quyền: Staff
            </span>
            <button type="button" class="btn btn-primary btn-sm px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalCreateTag" id="btnOpenCreateTagModal">
                <i class="bi bi-plus-circle me-1"></i>Thêm thẻ mới
            </button>
        </div>
    </div>

    <!-- Alert thông báo lỗi (nếu có) -->
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5 align-middle"></i>
            <span>@Model.ErrorMessage</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search & Filter Card -->
    <div class="card card-fu shadow-sm mb-4 border-0">
        <div class="card-body p-3">
            <form method="get" id="formFilterTags" class="row g-2 align-items-center">
                <div class="col-12 col-md-8">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light text-muted border-end-0">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" class="form-control border-start-0" id="inputSearchTag" name="search"
                               value="@Model.SearchKeyword" placeholder="Tìm kiếm theo tên thẻ tin hoặc ghi chú..." />
                        @if (!string.IsNullOrWhiteSpace(Model.SearchKeyword))
                        {
                            <a asp-page="/Staff/Tags" class="btn btn-outline-secondary" title="Xóa tìm kiếm">
                                <i class="bi bi-x-lg"></i>
                            </a>
                        }
                    </div>
                </div>
                <div class="col-12 col-md-4 d-flex justify-content-md-end gap-2">
                    <button type="submit" class="btn btn-outline-primary btn-sm px-3" id="btnSearchSubmit">
                        <i class="bi bi-filter me-1"></i>Tìm kiếm
                    </button>
                    <a asp-page="/Staff/Tags" class="btn btn-outline-secondary btn-sm px-3" id="btnResetFilter">
                        <i class="bi bi-arrow-clockwise me-1"></i>Làm mới
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Data Table Card -->
    <div class="card card-fu shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <span class="fw-semibold text-secondary small text-uppercase">
                <i class="bi bi-table me-1"></i>Danh sách thẻ tin trong hệ thống
            </span>
            <span class="badge bg-light text-dark border">
                Tổng cộng: <strong id="badgeTotalTagsCount">@Model.TotalCount</strong> thẻ
            </span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="tableTags">
                <thead class="table-light text-secondary small text-uppercase">
                    <tr>
                        <th scope="col" class="text-center" style="width: 80px;">Mã</th>
                        <th scope="col" style="min-width: 180px;">Tên thẻ (Tag Name)</th>
                        <th scope="col" style="min-width: 250px;">Ghi chú (Note)</th>
                        <th scope="col" class="text-center" style="width: 150px;">Số bài viết</th>
                        <th scope="col" class="text-center" style="width: 160px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody id="tableTagsBody">
                    @if (Model.Tags == null || !Model.Tags.Any())
                    {
                        <tr id="rowEmptyTags">
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-tags fs-1 d-block mb-2 text-secondary"></i>
                                <span>Không tìm thấy thẻ tin tức nào phù hợp với điều kiện tìm kiếm.</span>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var tag in Model.Tags)
                        {
                            <tr id="row-tag-@tag.TagId"
                                data-tag-id="@tag.TagId"
                                data-tag-name="@tag.TagName"
                                data-tag-note="@tag.Note"
                                data-article-count="@tag.ArticleCount">
                                <td class="text-center fw-semibold text-muted small cell-tag-id">#@tag.TagId</td>
                                <td>
                                    <span class="badge bg-light text-dark border px-2 py-1 fs-6 fw-semibold cell-tag-name">
                                        <i class="bi bi-hash text-primary"></i>@tag.TagName
                                    </span>
                                </td>
                                <td>
                                    <span class="text-secondary small cell-tag-note">
                                        @(string.IsNullOrWhiteSpace(tag.Note) ? "—" : tag.Note)
                                    </span>
                                </td>
                                <td class="text-center">
                                    @if (tag.ArticleCount > 0)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-info rounded-pill px-3 py-0 btn-view-tag-articles"
                                                data-tag-id="@tag.TagId" data-tag-name="@tag.TagName" title="Xem các bài viết đang gắn thẻ này">
                                            <i class="bi bi-newspaper me-1"></i><span class="cell-article-count">@tag.ArticleCount</span> bài
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border px-2 py-1">
                                            <span class="cell-article-count">0</span> bài
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <button type="button" class="btn btn-outline-primary btn-sm btn-edit-tag"
                                                data-tag-id="@tag.TagId" title="Chỉnh sửa thẻ tin">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button type="button" class="btn btn-outline-danger btn-sm btn-delete-tag"
                                                data-tag-id="@tag.TagId" title="Xóa thẻ tin">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ======================================================== -->
<!-- MODAL 1: THÊM MỚI THẺ TIN TỨC (AJAX - FUN-010)          -->
<!-- ======================================================== -->
<div class="modal fade" id="modalCreateTag" tabindex="-1" aria-labelledby="modalCreateTagLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow">
            <div class="modal-header bg-primary text-white py-3">
                <h5 class="modal-title h6 fw-bold mb-0" id="modalCreateTagLabel">
                    <i class="bi bi-tag me-2"></i>Thêm thẻ tin tức mới
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" id="btnCloseCreateTagModal"></button>
            </div>
            <form id="formCreateTag" novalidate>
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <!-- Alert thông báo lỗi tổng quan -->
                    <div class="alert alert-danger d-none py-2 mb-3" id="createTagAlert" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <span id="createTagAlertText"></span>
                    </div>

                    <!-- Tên thẻ tin (TagName) -->
                    <div class="mb-3">
                        <label for="createTagName" class="form-label fw-semibold small">
                            Tên thẻ tin (Tag Name) <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted">#</span>
                            <input type="text" class="form-control" id="createTagName" name="tagName"
                                   placeholder="Ví dụ: AI, CongNghe, PRN232" maxlength="50" required />
                        </div>
                        <div class="form-text text-muted small text-end"><span id="createTagNameCount">0</span>/50 ký tự</div>
                        <div class="invalid-feedback d-block d-none" id="errorCreateTagName">Tên thẻ tin là bắt buộc (tối đa 50 ký tự).</div>
                    </div>

                    <!-- Ghi chú thẻ tin (Note) -->
                    <div class="mb-3">
                        <label for="createTagNote" class="form-label fw-semibold small">
                            Ghi chú (Note) <span class="text-muted">(Tùy chọn)</span>
                        </label>
                        <textarea class="form-control" id="createTagNote" name="note" rows="3"
                                  placeholder="Mô tả mục đích sử dụng hoặc định nghĩa thẻ..." maxlength="400"></textarea>
                        <div class="form-text text-muted small text-end"><span id="createTagNoteCount">0</span>/400 ký tự</div>
                        <div class="invalid-feedback d-block d-none" id="errorCreateTagNote">Ghi chú không được vượt quá 400 ký tự.</div>
                    </div>
                </div>

                <div class="modal-footer bg-light py-2 px-4">
                    <button type="button" class="btn btn-outline-secondary btn-sm px-3" data-bs-dismiss="modal" id="btnCancelCreateTagModal">Hủy</button>
                    <button type="submit" class="btn btn-primary btn-sm px-4" id="btnSubmitCreateTag">
                        <span class="spinner-border spinner-border-sm me-1 d-none" id="spinnerCreateTag" role="status" aria-hidden="true"></span>
                        <span id="btnTextCreateTag">Lưu thẻ tin</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ======================================================== -->
<!-- MODAL 2: CHỈNH SỬA THẺ TIN TỨC (AJAX - FUN-010)         -->
<!-- ======================================================== -->
<div class="modal fade" id="modalEditTag" tabindex="-1" aria-labelledby="modalEditTagLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow">
            <div class="modal-header bg-primary text-white py-3">
                <h5 class="modal-title h6 fw-bold mb-0" id="modalEditTagLabel">
                    <i class="bi bi-pencil-square me-2"></i>Chỉnh sửa thẻ tin tức
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" id="btnCloseEditTagModal"></button>
            </div>
            <form id="formEditTag" novalidate>
