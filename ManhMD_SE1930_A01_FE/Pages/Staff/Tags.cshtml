                        <div class="form-text text-muted small text-end"><span id="editTagNoteCount">0</span>/400 ký tự</div>
                        <div class="invalid-feedback d-block d-none" id="errorEditTagNote">Ghi chú không được vượt quá 400 ký tự.</div>
                    </div>
                </div>

                <div class="modal-footer bg-light py-2 px-4">
                    <button type="button" class="btn btn-outline-secondary btn-sm px-3" data-bs-dismiss="modal" id="btnCancelEditTagModal">Hủy</button>
                    <button type="submit" class="btn btn-primary btn-sm px-4" id="btnSubmitEditTag">
                        <span class="spinner-border spinner-border-sm me-1 d-none" id="spinnerEditTag" role="status" aria-hidden="true"></span>
                        <span id="btnTextEditTag">Lưu thay đổi</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ======================================================== -->
<!-- MODAL 3: XÁC NHẬN XÓA THẺ TIN TỨC (AJAX - FUN-010)      -->
<!-- ======================================================== -->
<div class="modal fade" id="modalDeleteTag" tabindex="-1" aria-labelledby="modalDeleteTagLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow border-danger">
            <div class="modal-header bg-danger text-white py-3">
                <h5 class="modal-title h6 fw-bold mb-0" id="modalDeleteTagLabel">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Xác nhận xóa thẻ tin tức
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" id="btnCloseDeleteTagModal"></button>
            </div>
            <form id="formDeleteTag">
                @Html.AntiForgeryToken()
                <input type="hidden" id="deleteTagId" name="tagId" />
                <div class="modal-body p-4">
                    <!-- Alert thông báo lỗi khi xóa -->
                    <div class="alert alert-danger d-none py-2 mb-3" id="deleteTagAlert" role="alert">
                        <i class="bi bi-x-circle-fill me-2"></i>
                        <span id="deleteTagAlertText"></span>
                    </div>

                    <p class="mb-2">Bạn có chắc chắn muốn xóa thẻ tin sau khỏi hệ thống?</p>
                    <div class="p-3 bg-light rounded border mb-3">
                        <div class="fw-bold text-dark fs-6" id="deleteTagNameDisplay">#Tên thẻ</div>
                        <div class="text-muted small mt-1" id="deleteTagNoteDisplay">Ghi chú thẻ</div>
                        <div class="mt-2 small">
                            <span class="badge bg-primary-subtle text-primary border" id="deleteTagArticlesBadge">0 bài viết</span>
                        </div>
                    </div>

                    <!-- Cảnh báo nếu thẻ đang được sử dụng (AC 2) -->
                    <div class="alert alert-warning py-2 mb-0 small d-none" id="deleteTagBlockedNotice">
                        <i class="bi bi-shield-exclamation me-1 fs-6"></i>
                        <strong>Lưu ý:</strong> Thẻ tin này đang được liên kết với một hoặc nhiều bài viết. Hệ thống <strong>tuyệt đối không cho phép xóa</strong> thẻ đang được sử dụng để tránh tạo bản ghi orphan NewsTag.
                    </div>
                </div>

                <div class="modal-footer bg-light py-2 px-4">
                    <button type="button" class="btn btn-outline-secondary btn-sm px-3" data-bs-dismiss="modal" id="btnCancelDeleteTagModal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-danger btn-sm px-4" id="btnSubmitDeleteTag">
                        <span class="spinner-border spinner-border-sm me-1 d-none" id="spinnerDeleteTag" role="status" aria-hidden="true"></span>
                        <span id="btnTextDeleteTag">Xác nhận xóa</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ======================================================== -->
<!-- MODAL 4: XEM BÀI VIẾT GẮN THẺ TIN TỨC (AJAX - FUN-010)  -->
<!-- ======================================================== -->
<div class="modal fade" id="modalTagArticles" tabindex="-1" aria-labelledby="modalTagArticlesLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content shadow">
            <div class="modal-header bg-light py-3 border-bottom">
                <h5 class="modal-title h6 fw-bold mb-0 text-dark" id="modalTagArticlesLabel">
                    <i class="bi bi-newspaper text-primary me-2"></i>Danh sách bài viết gắn thẻ: <span class="badge bg-primary text-white" id="displayTagArticlesName">#Tag</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <!-- Spinner loading -->
                <div class="text-center py-4 d-none" id="spinnerTagArticlesLoading">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Đang tải...</span>
                    </div>
                    <p class="text-muted small mt-2">Đang tải danh sách bài viết...</p>
                </div>

                <!-- Alert lỗi -->
                <div class="alert alert-danger d-none py-2 mb-3" id="alertTagArticlesError" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <span id="textTagArticlesError"></span>
                </div>

                <!-- Table Articles -->
                <div class="table-responsive" id="containerTagArticlesTable">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light small text-uppercase text-secondary">
                            <tr>
                                <th style="width: 100px;">Mã tin</th>
                                <th>Tiêu đề bài viết</th>
                                <th style="width: 140px;">Chuyên mục</th>
                                <th style="width: 130px;">Ngày tạo</th>
                                <th class="text-center" style="width: 120px;">Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyTagArticles">
                            <!-- Injected by JavaScript -->
                        </tbody>
                    </table>
                </div>

                <!-- Empty state -->
                <div class="text-center py-5 text-muted d-none" id="emptyTagArticles">
                    <i class="bi bi-journal-x fs-1 d-block mb-2 text-secondary"></i>
                    <span>Chưa có bài viết nào được gắn thẻ tin này.</span>
                </div>
            </div>
            <div class="modal-footer bg-light py-2 px-4">
                <button type="button" class="btn btn-secondary btn-sm px-3" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<!-- Toast thông báo thành công / lỗi -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1080;">
    <div id="tagToast" class="toast align-items-center text-white bg-success border-0 shadow" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body d-flex align-items-center">
                <i class="bi bi-check-circle-fill me-2 fs-6"></i>
                <span id="tagToastMsg">Thao tác thành công.</span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Anti-Forgery Token
            function getCsrfToken() {
                const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                return tokenInput ? tokenInput.value : '';
            }

            // Toast
            const toastEl = document.getElementById('tagToast');
            const toastMsg = document.getElementById('tagToastMsg');
            const bsToast = toastEl ? new bootstrap.Toast(toastEl, { delay: 4000 }) : null;

            function showToast(msg, isSuccess = true) {
                if (!bsToast || !toastEl || !toastMsg) return;
                toastMsg.textContent = msg;
                toastEl.className = isSuccess
                    ? 'toast align-items-center text-white bg-success border-0 shadow'
                    : 'toast align-items-center text-white bg-danger border-0 shadow';
                bsToast.show();
            }

            function escapeHtml(str) {
                if (!str) return '';
                return String(str)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#39;');
            }

            function clearFieldError(input, errorSpanId) {
                if (input) input.classList.remove('is-invalid');
                const errSpan = document.getElementById(errorSpanId);
                if (errSpan) {
                    errSpan.classList.add('d-none');
                    errSpan.textContent = '';
                }
            }

            function setFieldError(input, errorSpanId, message) {
                if (input) input.classList.add('is-invalid');
                const errSpan = document.getElementById(errorSpanId);
                if (errSpan) {
                    errSpan.textContent = message;
                    errSpan.classList.remove('d-none');
                }
            }

            // ==========================================
            // 1. MODAL TẠO MỚI THẺ TIN
            // ==========================================
            const createModalEl = document.getElementById('modalCreateTag');
            const createModal = createModalEl ? new bootstrap.Modal(createModalEl) : null;
            const createForm = document.getElementById('formCreateTag');
            const createNameInput = document.getElementById('createTagName');
            const createNameCount = document.getElementById('createTagNameCount');
            const createNoteInput = document.getElementById('createTagNote');
            const createNoteCount = document.getElementById('createTagNoteCount');
            const createAlertBox = document.getElementById('createTagAlert');
            const createAlertText = document.getElementById('createTagAlertText');
            const createSubmitBtn = document.getElementById('btnSubmitCreateTag');
            const createSpinner = document.getElementById('spinnerCreateTag');
            const createBtnText = document.getElementById('btnTextCreateTag');

            createNameInput?.addEventListener('input', function () {
                if (createNameCount) createNameCount.textContent = createNameInput.value.length;
                clearFieldError(createNameInput, 'errorCreateTagName');
            });

            createNoteInput?.addEventListener('input', function () {
                if (createNoteCount) createNoteCount.textContent = createNoteInput.value.length;
                clearFieldError(createNoteInput, 'errorCreateTagNote');
            });

            createModalEl?.addEventListener('show.bs.modal', function () {
                createForm?.reset();
                if (createNameCount) createNameCount.textContent = '0';
                if (createNoteCount) createNoteCount.textContent = '0';
                clearFieldError(createNameInput, 'errorCreateTagName');
                clearFieldError(createNoteInput, 'errorCreateTagNote');
                if (createAlertBox) createAlertBox.classList.add('d-none');
            });

            createForm?.addEventListener('submit', async function (e) {
                e.preventDefault();

                let isValid = true;
                const nameVal = createNameInput ? createNameInput.value.trim() : '';
                const noteVal = createNoteInput ? createNoteInput.value.trim() : '';

                if (!nameVal) {
                    setFieldError(createNameInput, 'errorCreateTagName', 'Tên thẻ tin là bắt buộc.');
                    isValid = false;
                } else if (nameVal.length > 50) {
                    setFieldError(createNameInput, 'errorCreateTagName', 'Tên thẻ tin không được vượt quá 50 ký tự.');
                    isValid = false;
                }

                if (noteVal && noteVal.length > 400) {
                    setFieldError(createNoteInput, 'errorCreateTagNote', 'Ghi chú thẻ tin không được vượt quá 400 ký tự.');
                    isValid = false;
                }

                if (!isValid) return;

                const payload = {
                    tagName: nameVal,
                    note: noteVal || null
                };

                if (createSubmitBtn) createSubmitBtn.disabled = true;
                if (createSpinner) createSpinner.classList.remove('d-none');
                if (createBtnText) createBtnText.textContent = 'Đang lưu...';
                if (createAlertBox) createAlertBox.classList.add('d-none');

                try {
                    const response = await fetch('/staff/tags?handler=Create', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-CSRF-TOKEN': getCsrfToken()
                        },
                        body: JSON.stringify(payload)
                    });

                    const result = await response.json();

                    if (result && result.success) {
                        createModal?.hide();
                        showToast(result.message || 'Thêm thẻ tin tức thành công.');
                        insertTagRow(result.tag);

                        const badgeTotal = document.getElementById('badgeTotalTagsCount');
                        if (badgeTotal) {
                            const current = parseInt(badgeTotal.textContent) || 0;
                            badgeTotal.textContent = current + 1;
                        }
                    } else {
                        const msg = (result && result.message) ? result.message : 'Không thể thêm thẻ tin tức.';
                        if (createAlertText) createAlertText.textContent = msg;
                        if (createAlertBox) createAlertBox.classList.remove('d-none');

                        if (result && result.errors) {
                            for (const [key, errArr] of Object.entries(result.errors)) {
                                const errText = Array.isArray(errArr) ? errArr.join(', ') : errArr;
                                if (key.toLowerCase().includes('name')) {
                                    setFieldError(createNameInput, 'errorCreateTagName', errText);
                                } else if (key.toLowerCase().includes('note')) {
                                    setFieldError(createNoteInput, 'errorCreateTagNote', errText);
                                }
                            }
                        }
                    }
                } catch (err) {
                    if (createAlertText) createAlertText.textContent = 'Lỗi kết nối tới máy chủ khi tạo thẻ tin tức.';
                    if (createAlertBox) createAlertBox.classList.remove('d-none');
                } finally {
                    if (createSubmitBtn) createSubmitBtn.disabled = false;
                    if (createSpinner) createSpinner.classList.add('d-none');
                    if (createBtnText) createBtnText.textContent = 'Lưu thẻ tin';
                }
            });

            // ==========================================
            // 2. MODAL CHỈNH SỬA THẺ TIN
            // ==========================================
            const editModalEl = document.getElementById('modalEditTag');
            const editModal = editModalEl ? new bootstrap.Modal(editModalEl) : null;
            const editForm = document.getElementById('formEditTag');
            const editIdInput = document.getElementById('editTagId');
            const editNameInput = document.getElementById('editTagName');
            const editNameCount = document.getElementById('editTagNameCount');
            const editNoteInput = document.getElementById('editTagNote');
            const editNoteCount = document.getElementById('editTagNoteCount');
            const editAlertBox = document.getElementById('editTagAlert');
            const editAlertText = document.getElementById('editTagAlertText');
            const editSubmitBtn = document.getElementById('btnSubmitEditTag');
            const editSpinner = document.getElementById('spinnerEditTag');
            const editBtnText = document.getElementById('btnTextEditTag');

            editNameInput?.addEventListener('input', function () {
                if (editNameCount) editNameCount.textContent = editNameInput.value.length;
                clearFieldError(editNameInput, 'errorEditTagName');
            });

            editNoteInput?.addEventListener('input', function () {
                if (editNoteCount) editNoteCount.textContent = editNoteInput.value.length;
                clearFieldError(editNoteInput, 'errorEditTagNote');
            });

            function openEditModal(row) {
                if (!row) return;

                const tagId = parseInt(row.getAttribute('data-tag-id'));
                const name = row.getAttribute('data-tag-name') || '';
                const note = row.getAttribute('data-tag-note') || '';

                if (editIdInput) editIdInput.value = tagId;
                if (editNameInput) editNameInput.value = name;
                if (editNameCount) editNameCount.textContent = name.length;
                if (editNoteInput) editNoteInput.value = note;
                if (editNoteCount) editNoteCount.textContent = note.length;

                clearFieldError(editNameInput, 'errorEditTagName');
                clearFieldError(editNoteInput, 'errorEditTagNote');
                if (editAlertBox) editAlertBox.classList.add('d-none');

                editModal?.show();
            }

            editForm?.addEventListener('submit', async function (e) {
                e.preventDefault();

                let isValid = true;
                const tagId = parseInt(editIdInput.value);
                const nameVal = editNameInput ? editNameInput.value.trim() : '';
                const noteVal = editNoteInput ? editNoteInput.value.trim() : '';

                if (!nameVal) {
                    setFieldError(editNameInput, 'errorEditTagName', 'Tên thẻ tin là bắt buộc.');
                    isValid = false;
                } else if (nameVal.length > 50) {
                    setFieldError(editNameInput, 'errorEditTagName', 'Tên thẻ tin không được vượt quá 50 ký tự.');
                    isValid = false;
                }

                if (noteVal && noteVal.length > 400) {
                    setFieldError(editNoteInput, 'errorEditTagNote', 'Ghi chú không được vượt quá 400 ký tự.');
                    isValid = false;
                }

                if (!isValid) return;

                const payload = {
                    tagId: tagId,
                    tagName: nameVal,
                    note: noteVal || null
                };

                if (editSubmitBtn) editSubmitBtn.disabled = true;
                if (editSpinner) editSpinner.classList.remove('d-none');
                if (editBtnText) editBtnText.textContent = 'Đang lưu...';
                if (editAlertBox) editAlertBox.classList.add('d-none');

                try {
                    const response = await fetch('/staff/tags?handler=Update', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-CSRF-TOKEN': getCsrfToken()
                        },
                        body: JSON.stringify(payload)
                    });

                    const result = await response.json();

                    if (result && result.success) {
                        editModal?.hide();
                        showToast(result.message || 'Cập nhật thẻ tin tức thành công.');
                        updateTagRow(result.tag);
                    } else {
                        const msg = (result && result.message) ? result.message : 'Không thể cập nhật thẻ tin tức.';
                        if (editAlertText) editAlertText.textContent = msg;
                        if (editAlertBox) editAlertBox.classList.remove('d-none');

                        if (result && result.errors) {
                            for (const [key, errArr] of Object.entries(result.errors)) {
                                const errText = Array.isArray(errArr) ? errArr.join(', ') : errArr;
                                if (key.toLowerCase().includes('name')) {
                                    setFieldError(editNameInput, 'errorEditTagName', errText);
                                } else if (key.toLowerCase().includes('note')) {
                                    setFieldError(editNoteInput, 'errorEditTagNote', errText);
                                }
                            }
                        }
                    }
                } catch (err) {
                    if (editAlertText) editAlertText.textContent = 'Lỗi kết nối tới máy chủ khi cập nhật thẻ tin.';
                    if (editAlertBox) editAlertBox.classList.remove('d-none');
                } finally {
                    if (editSubmitBtn) editSubmitBtn.disabled = false;
                    if (editSpinner) editSpinner.classList.add('d-none');
                    if (editBtnText) editBtnText.textContent = 'Lưu thay đổi';
                }
            });

            // ==========================================
            // 3. MODAL XÁC NHẬN XÓA THẺ TIN
            // ==========================================
            const deleteModalEl = document.getElementById('modalDeleteTag');
            const deleteModal = deleteModalEl ? new bootstrap.Modal(deleteModalEl) : null;
            const deleteForm = document.getElementById('formDeleteTag');
            const deleteIdInput = document.getElementById('deleteTagId');
            const deleteNameDisplay = document.getElementById('deleteTagNameDisplay');
            const deleteNoteDisplay = document.getElementById('deleteTagNoteDisplay');
            const deleteArticlesBadge = document.getElementById('deleteTagArticlesBadge');
            const deleteBlockedNotice = document.getElementById('deleteTagBlockedNotice');
            const deleteAlertBox = document.getElementById('deleteTagAlert');
            const deleteAlertText = document.getElementById('deleteTagAlertText');
            const deleteSubmitBtn = document.getElementById('btnSubmitDeleteTag');
            const deleteSpinner = document.getElementById('spinnerDeleteTag');
            const deleteBtnText = document.getElementById('btnTextDeleteTag');

            function updateDeleteModalState(articleCount) {
                if (deleteArticlesBadge) deleteArticlesBadge.textContent = `${articleCount} bài viết`;
                if (articleCount > 0) {
                    if (deleteBlockedNotice) deleteBlockedNotice.classList.remove('d-none');
                    if (deleteSubmitBtn) deleteSubmitBtn.disabled = true;
                } else {
                    if (deleteBlockedNotice) deleteBlockedNotice.classList.add('d-none');
                    if (deleteSubmitBtn) deleteSubmitBtn.disabled = false;
                }
            }

            async function openDeleteModal(row) {
                if (!row) return;

                const tagId = parseInt(row.getAttribute('data-tag-id'));
                const name = row.getAttribute('data-tag-name') || '';
                const note = row.getAttribute('data-tag-note') || '';
                let articleCount = parseInt(row.getAttribute('data-article-count')) || 0;

                if (deleteIdInput) deleteIdInput.value = tagId;
                if (deleteNameDisplay) deleteNameDisplay.textContent = `#${tagId} - ${name}`;
                if (deleteNoteDisplay) deleteNoteDisplay.textContent = note || 'Không có ghi chú';

                if (deleteAlertBox) deleteAlertBox.classList.add('d-none');

                // Hiển thị ngay trạng thái từ DOM row
                updateDeleteModalState(articleCount);

                deleteModal?.show();

                // F-003, F-010: Kiểm tra số lượng bài viết thời gian thực từ server tránh stale data
                try {
                    const response = await fetch(`/staff/tags?handler=Articles&id=${tagId}`, {
                        headers: { 'Accept': 'application/json' }
                    });
                    const result = await response.json();
                    if (result && result.success && Array.isArray(result.articles)) {
                        articleCount = result.articles.length;
                        row.setAttribute('data-article-count', articleCount);
                        const countCell = row.querySelector('.cell-article-count');
                        if (countCell) countCell.textContent = articleCount;
                        updateDeleteModalState(articleCount);
                    }
                } catch (e) {
                    // Tiếp tục giữ trạng thái từ DOM nếu mất kết nối
                }
            }

            deleteForm?.addEventListener('submit', async function (e) {
                e.preventDefault();

                const tagId = parseInt(deleteIdInput.value);
                if (isNaN(tagId) || tagId <= 0) return;

                if (deleteSubmitBtn) deleteSubmitBtn.disabled = true;
                if (deleteSpinner) deleteSpinner.classList.remove('d-none');
                if (deleteBtnText) deleteBtnText.textContent = 'Đang xóa...';
                if (deleteAlertBox) deleteAlertBox.classList.add('d-none');

                try {
                    const response = await fetch(`/staff/tags?handler=Delete&id=${tagId}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-CSRF-TOKEN': getCsrfToken()
                        }
                    });

                    const result = await response.json();

                    if (result && result.success) {
                        deleteModal?.hide();
                        showToast(result.message || 'Xóa thẻ tin thành công.');
                        removeTagRow(tagId);

                        const badgeTotal = document.getElementById('badgeTotalTagsCount');
                        if (badgeTotal) {
                            const current = parseInt(badgeTotal.textContent) || 0;
                            badgeTotal.textContent = Math.max(0, current - 1);
                        }
                    } else {
                        const msg = (result && result.message) ? result.message : 'Không thể xóa thẻ tin do ràng buộc dữ liệu.';
                        if (deleteAlertText) deleteAlertText.textContent = msg;
                        if (deleteAlertBox) deleteAlertBox.classList.remove('d-none');
                    }
                } catch (err) {
                    if (deleteAlertText) deleteAlertText.textContent = 'Lỗi kết nối tới máy chủ khi xóa dữ liệu.';
                    if (deleteAlertBox) deleteAlertBox.classList.remove('d-none');
                } finally {
                    if (deleteSubmitBtn) deleteSubmitBtn.disabled = false;
                    if (deleteSpinner) deleteSpinner.classList.add('d-none');
                    if (deleteBtnText) deleteBtnText.textContent = 'Xác nhận xóa';
                }
            });

            // ==========================================
            // 4. MODAL XEM CÁC BÀI VIẾT GẮN THẺ (AC 3, AC 4)
            // ==========================================
            const articlesModalEl = document.getElementById('modalTagArticles');
            const articlesModal = articlesModalEl ? new bootstrap.Modal(articlesModalEl) : null;
            const displayTagName = document.getElementById('displayTagArticlesName');
            const spinnerLoading = document.getElementById('spinnerTagArticlesLoading');
            const tableContainer = document.getElementById('containerTagArticlesTable');
            const tbodyArticles = document.getElementById('tbodyTagArticles');
            const emptyArticles = document.getElementById('emptyTagArticles');
            const alertArticlesError = document.getElementById('alertTagArticlesError');
            const textArticlesError = document.getElementById('textTagArticlesError');

            async function openArticlesModal(tagId, tagName) {
                if (displayTagName) displayTagName.textContent = `#${tagName}`;
                if (tbodyArticles) tbodyArticles.innerHTML = '';
                if (alertArticlesError) alertArticlesError.classList.add('d-none');
                if (emptyArticles) emptyArticles.classList.add('d-none');
                if (tableContainer) tableContainer.classList.add('d-none');
                if (spinnerLoading) spinnerLoading.classList.remove('d-none');

                articlesModal?.show();

                try {
                    const response = await fetch(`/staff/tags?handler=Articles&id=${tagId}`, {
                        headers: { 'Accept': 'application/json' }
                    });
                    const result = await response.json();

                    if (spinnerLoading) spinnerLoading.classList.add('d-none');

                    if (result && result.success) {
                        const articles = result.articles || [];
                        if (articles.length === 0) {
                            if (emptyArticles) emptyArticles.classList.remove('d-none');
                        } else {
                            if (tableContainer) tableContainer.classList.remove('d-none');
                            renderArticlesTable(articles);
                        }
                    } else {
                        if (alertArticlesError) alertArticlesError.classList.remove('d-none');
                        if (textArticlesError) textArticlesError.textContent = result?.message || 'Không thể tải danh sách bài viết.';
                    }
                } catch (err) {
                    if (spinnerLoading) spinnerLoading.classList.add('d-none');
                    if (alertArticlesError) alertArticlesError.classList.remove('d-none');
                    if (textArticlesError) textArticlesError.textContent = 'Lỗi kết nối tới máy chủ.';
                }
            }

            function renderArticlesTable(articles) {
                if (!tbodyArticles) return;
                tbodyArticles.innerHTML = '';

                articles.forEach(a => {
                    const tr = document.createElement('tr');
                    const statusBadge = a.newsStatus === true
                        ? `<span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1"><i class="bi bi-check-circle me-1"></i>Xuất bản</span>`
                        : `<span class="badge bg-secondary-subtle text-secondary border px-2 py-1"><i class="bi bi-dash-circle me-1"></i>Bản nháp</span>`;

                    const dateStr = a.createdDate ? new Date(a.createdDate).toLocaleDateString('vi-VN') : '—';
                    const catName = a.categoryName ? escapeHtml(a.categoryName) : '—';

                    tr.innerHTML = `
                        <td class="fw-semibold text-muted small">${escapeHtml(a.newsArticleId)}</td>
                        <td>
                            <div class="fw-medium text-dark text-truncate" style="max-width: 320px;" title="${escapeHtml(a.newsTitle || a.headline)}">
                                ${escapeHtml(a.newsTitle || a.headline)}
                            </div>
                            <div class="text-muted small text-truncate" style="max-width: 320px;">${escapeHtml(a.headline)}</div>
                        </td>
                        <td><span class="badge bg-light text-dark border">${catName}</span></td>
                        <td class="small text-muted">${dateStr}</td>
                        <td class="text-center">${statusBadge}</td>
                    `;
                    tbodyArticles.appendChild(tr);
                });
            }

            // ==========================================
            // 5. EVENT DELEGATION BẢNG DANH SÁCH THẺ
            // ==========================================
            document.getElementById('tableTagsBody')?.addEventListener('click', function (e) {
                const editBtn = e.target.closest('.btn-edit-tag');
                if (editBtn) {
                    const row = editBtn.closest('tr');
                    openEditModal(row);
                    return;
                }

                const deleteBtn = e.target.closest('.btn-delete-tag');
                if (deleteBtn) {
                    const row = deleteBtn.closest('tr');
                    openDeleteModal(row);
                    return;
                }

                const viewBtn = e.target.closest('.btn-view-tag-articles');
                if (viewBtn) {
                    const tagId = parseInt(viewBtn.getAttribute('data-tag-id'));
                    const tagName = viewBtn.getAttribute('data-tag-name');
                    openArticlesModal(tagId, tagName);
                    return;
                }
            });

            // ==========================================
            // 6. CẬP NHẬT GIAO DIỆN DOM ĐỘNG
            // ==========================================
            function insertTagRow(tag) {
                if (!tag) return;
                const tbody = document.getElementById('tableTagsBody');
                if (!tbody) return;

                const emptyRow = document.getElementById('rowEmptyTags');
                if (emptyRow) emptyRow.remove();

                const tr = document.createElement('tr');
                tr.id = `row-tag-${tag.tagId}`;
                tr.setAttribute('data-tag-id', tag.tagId);
                tr.setAttribute('data-tag-name', tag.tagName);
                tr.setAttribute('data-tag-note', tag.note || '');
                tr.setAttribute('data-article-count', tag.articleCount || 0);
                tr.className = 'table-success-subtle';

                tr.innerHTML = `
                    <td class="text-center fw-semibold text-muted small cell-tag-id">#${tag.tagId}</td>
                    <td>
                        <span class="badge bg-light text-dark border px-2 py-1 fs-6 fw-semibold cell-tag-name">
                            <i class="bi bi-hash text-primary"></i>${escapeHtml(tag.tagName)}
                        </span>
                    </td>
                    <td>
                        <span class="text-secondary small cell-tag-note">
                            ${escapeHtml(tag.note || '—')}
                        </span>
                    </td>
                    <td class="text-center">
                        <span class="badge bg-secondary-subtle text-secondary border px-2 py-1">
                            <span class="cell-article-count">0</span> bài
                        </span>
                    </td>
                    <td class="text-center">
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button" class="btn btn-outline-primary btn-sm btn-edit-tag" data-tag-id="${tag.tagId}" title="Chỉnh sửa thẻ tin">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button type="button" class="btn btn-outline-danger btn-sm btn-delete-tag" data-tag-id="${tag.tagId}" title="Xóa thẻ tin">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </td>
                `;

                tbody.insertBefore(tr, tbody.firstChild);

                setTimeout(() => {
                    tr.classList.remove('table-success-subtle');
                }, 2000);
            }

            function updateTagRow(tag) {
                if (!tag) return;
                const row = document.getElementById(`row-tag-${tag.tagId}`);
                if (!row) return;

                row.setAttribute('data-tag-name', tag.tagName);
                row.setAttribute('data-tag-note', tag.note || '');

                if (tag.articleCount !== undefined && tag.articleCount !== null) {
                    row.setAttribute('data-article-count', tag.articleCount);
                    const countCell = row.querySelector('.cell-article-count');
                    if (countCell) countCell.textContent = tag.articleCount;
                }

                const nameCell = row.querySelector('.cell-tag-name');
                if (nameCell) nameCell.innerHTML = `<i class="bi bi-hash text-primary"></i>${escapeHtml(tag.tagName)}`;

                const noteCell = row.querySelector('.cell-tag-note');
                if (noteCell) noteCell.textContent = tag.note || '—';

                row.classList.add('table-info-subtle');
                setTimeout(() => {
                    row.classList.remove('table-info-subtle');
                }, 2000);
            }

            function removeTagRow(tagId) {
                const row = document.getElementById(`row-tag-${tagId}`);
                if (!row) return;

                row.classList.add('table-danger-subtle');
                setTimeout(() => {
                    row.remove();

                    const tbody = document.getElementById('tableTagsBody');
                    if (tbody && tbody.querySelectorAll('tr').length === 0) {
                        tbody.innerHTML = `
                            <tr id="rowEmptyTags">
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="bi bi-tags fs-1 d-block mb-2 text-secondary"></i>
                                    <span>Không tìm thấy thẻ tin tức nào phù hợp với điều kiện tìm kiếm.</span>
                                </td>
                            </tr>
                        `;
                    }
                }, 300);
            }
        });
    </script>
}
