@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Toast controllers
            const toastSuccessEl = document.getElementById('toastSuccess');
            const toastErrorEl = document.getElementById('toastError');
            const toastSuccess = toastSuccessEl ? new bootstrap.Toast(toastSuccessEl, { delay: 4000 }) : null;
            const toastError = toastErrorEl ? new bootstrap.Toast(toastErrorEl, { delay: 5000 }) : null;

            function showToast(isSuccess, message) {
                if (isSuccess) {
                    const msgEl = document.getElementById('toastSuccessMessage');
                    if (msgEl) msgEl.textContent = message;
                    toastSuccess?.show();
                } else {
                    const msgEl = document.getElementById('toastErrorMessage');
                    if (msgEl) msgEl.textContent = message;
                    toastError?.show();
                }
            }

            // ==========================================
            // MODAL CHI TIẾT BÀI VIẾT (FUN-011)
            // ==========================================
            const modalDetailEl = document.getElementById('modalNewsDetail');
            const detailModal = modalDetailEl ? new bootstrap.Modal(modalDetailEl) : null;

            const spinner = document.getElementById('spinnerNewsDetail');
            const alertError = document.getElementById('alertNewsDetailError');
            const textError = document.getElementById('textNewsDetailError');
            const content = document.getElementById('contentNewsDetail');

            const idEl = document.getElementById('detailNewsId');
            const statusEl = document.getElementById('detailNewsStatus');
            const titleEl = document.getElementById('detailNewsTitle');
            const headlineEl = document.getElementById('detailNewsHeadline');
            const categoryEl = document.getElementById('detailNewsCategory');
            const authorEl = document.getElementById('detailNewsAuthor');
            const createdDateEl = document.getElementById('detailNewsCreatedDate');
            const sourceEl = document.getElementById('detailNewsSource');
            const modifiedDateEl = document.getElementById('detailNewsModifiedDate');
            const lastEditorEl = document.getElementById('detailNewsLastEditor');
            const tagsEl = document.getElementById('detailNewsTags');
            const bodyEl = document.getElementById('detailNewsContent');

            function bindDetailButtons(container = document) {
                container.querySelectorAll('.btn-view-news').forEach(btn => {
                    // Tránh bind 2 lần
                    if (btn.hasAttribute('data-bound')) return;
                    btn.setAttribute('data-bound', 'true');

                    btn.addEventListener('click', async function () {
                        const newsId = this.getAttribute('data-news-id');
                        if (!newsId) return;

                        if (alertError) alertError.classList.add('d-none');
                        if (content) content.classList.add('d-none');
                        if (spinner) spinner.classList.remove('d-none');

                        detailModal?.show();

                        try {
                            const response = await fetch(`/staff/news?handler=Detail&id=${encodeURIComponent(newsId)}`, {
                                headers: { 'Accept': 'application/json' }
                            });
                            const result = await response.json();

                            if (result && result.success && result.article) {
                                const a = result.article;

                                if (idEl) idEl.textContent = `#${a.newsArticleId}`;
                                if (titleEl) titleEl.textContent = a.newsTitle || 'Không có tiêu đề';
                                if (headlineEl) headlineEl.textContent = a.headline || '—';
                                if (categoryEl) categoryEl.textContent = a.categoryName || 'Chưa phân loại';
                                if (authorEl) authorEl.textContent = a.authorName || 'Chưa ghi nhận';
                                if (sourceEl) sourceEl.textContent = a.newsSource || 'N/A';
                                if (createdDateEl) createdDateEl.textContent = a.createdDate ? new Date(a.createdDate).toLocaleString('vi-VN') : '—';
                                if (modifiedDateEl) modifiedDateEl.textContent = a.modifiedDate ? new Date(a.modifiedDate).toLocaleString('vi-VN') : 'Chưa chỉnh sửa';
                                if (lastEditorEl) lastEditorEl.textContent = a.lastEditorName || '—';

                                if (statusEl) {
                                    if (a.newsStatus === true) {
                                        statusEl.innerHTML = `<span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1"><i class="bi bi-check-circle-fill me-1"></i>Đang hiển thị</span>`;
                                    } else {
                                        statusEl.innerHTML = `<span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1"><i class="bi bi-eye-slash-fill me-1"></i>Tạm ẩn</span>`;
                                    }
                                }

                                if (tagsEl) {
                                    if (a.tags && a.tags.length > 0) {
                                        tagsEl.innerHTML = a.tags.map(t =>
                                            `<span class="badge bg-light text-dark border px-2 py-1">#${escapeHtml(t.tagName)}</span>`
                                        ).join('');
                                    } else {
                                        tagsEl.innerHTML = '<span class="text-muted small">Không có thẻ tin nào</span>';
                                    }
                                }

                                if (bodyEl) {
                                    bodyEl.textContent = a.newsContent || 'Không có nội dung.';
                                }

                                if (spinner) spinner.classList.add('d-none');
                                if (content) content.classList.remove('d-none');
                            } else {
                                const msg = (result && result.message) ? result.message : 'Không tìm thấy dữ liệu bài viết.';
                                if (textError) textError.textContent = msg;
                                if (spinner) spinner.classList.add('d-none');
                                if (alertError) alertError.classList.remove('d-none');
                            }
                        } catch (err) {
                            if (textError) textError.textContent = 'Lỗi kết nối khi tải chi tiết bài viết.';
                            if (spinner) spinner.classList.add('d-none');
                            if (alertError) alertError.classList.remove('d-none');
                        }
                    });
                });
            }

            bindDetailButtons();

            // ==========================================
            // MODAL TẠO BÀI VIẾT MỚI (FUN-012)
            // ==========================================
            const modalCreateEl = document.getElementById('modalCreateNews');
            const createModal = modalCreateEl ? new bootstrap.Modal(modalCreateEl) : null;
            const formCreate = document.getElementById('formCreateNews');

            const inputHeadline = document.getElementById('createNewsHeadline');
            const inputTitle = document.getElementById('createNewsTitle');
            const selectCategory = document.getElementById('createNewsCategory');
            const selectStatus = document.getElementById('createNewsStatus');
            const inputSource = document.getElementById('createNewsSource');
            const inputContent = document.getElementById('createNewsContent');

            const countHeadline = document.getElementById('createNewsHeadlineCount');
            const countTitle = document.getElementById('createNewsTitleCount');
            const countSource = document.getElementById('createNewsSourceCount');
            const countContent = document.getElementById('createNewsContentCount');

            const alertCreate = document.getElementById('createNewsAlert');
            const alertCreateText = document.getElementById('createNewsAlertText');

            const errorHeadline = document.getElementById('errorCreateNewsHeadline');
            const errorTitle = document.getElementById('errorCreateNewsTitle');
            const errorCategory = document.getElementById('errorCreateNewsCategory');
            const errorSource = document.getElementById('errorCreateNewsSource');
            const errorTags = document.getElementById('errorCreateNewsTags');
            const errorContent = document.getElementById('errorCreateNewsContent');

            const btnSubmitCreate = document.getElementById('btnSubmitCreateNews');
            const spinnerCreate = document.getElementById('spinnerCreateNews');
            const btnTextCreate = document.getElementById('btnTextCreateNews');

            // Cập nhật bộ đếm ký tự
            function setupCounter(input, counter) {
                if (!input || !counter) return;
                input.addEventListener('input', () => {
                    counter.textContent = input.value.length;
                });
            }

            setupCounter(inputHeadline, countHeadline);
            setupCounter(inputTitle, countTitle);
            setupCounter(inputSource, countSource);
            setupCounter(inputContent, countContent);

            function clearCreateValidationErrors() {
                if (alertCreate) alertCreate.classList.add('d-none');
                const inputs = [inputHeadline, inputTitle, selectCategory, inputSource, inputContent];
                inputs.forEach(el => el?.classList.remove('is-invalid'));
                const errors = [errorHeadline, errorTitle, errorCategory, errorSource, errorTags, errorContent];
                errors.forEach(el => el?.classList.add('d-none'));
            }

            function resetCreateForm() {
                formCreate?.reset();
                clearCreateValidationErrors();
                if (countHeadline) countHeadline.textContent = '0';
                if (countTitle) countTitle.textContent = '0';
                if (countSource) countSource.textContent = '0';
                if (countContent) countContent.textContent = '0';
                document.querySelectorAll('.create-news-tag-cb').forEach(cb => cb.checked = false);
            }

            modalCreateEl?.addEventListener('hidden.bs.modal', function () {
                resetCreateForm();
            });

            formCreate?.addEventListener('submit', async function (e) {
                e.preventDefault();
                clearCreateValidationErrors();

                // Lấy dữ liệu form
                const headline = inputHeadline ? inputHeadline.value.trim() : '';
                const title = inputTitle ? inputTitle.value.trim() : '';
                const categoryId = selectCategory ? parseInt(selectCategory.value) : 0;
                const status = selectStatus ? (selectStatus.value === 'true') : true;
                const source = inputSource ? inputSource.value.trim() : '';
                const contentText = inputContent ? inputContent.value.trim() : '';

                // Thu thập thẻ tin đã chọn (AC 5)
                const tagCheckboxes = document.querySelectorAll('.create-news-tag-cb:checked');
                const tagIds = Array.from(tagCheckboxes).map(cb => parseInt(cb.value)).filter(v => !isNaN(v) && v > 0);

                // Client validation cơ bản
                let hasClientError = false;
                if (!headline) {
                    inputHeadline?.classList.add('is-invalid');
                    if (errorHeadline) {
                        errorHeadline.textContent = 'Tiêu đề tóm tắt là bắt buộc.';
                        errorHeadline.classList.remove('d-none');
                    }
                    hasClientError = true;
                } else if (headline.length > 150) {
                    inputHeadline?.classList.add('is-invalid');
                    if (errorHeadline) {
                        errorHeadline.textContent = 'Tiêu đề tóm tắt không được vượt quá 150 ký tự.';
                        errorHeadline.classList.remove('d-none');
                    }
                    hasClientError = true;
                }

                if (!categoryId || isNaN(categoryId) || categoryId <= 0) {
                    selectCategory?.classList.add('is-invalid');
                    if (errorCategory) {
                        errorCategory.textContent = 'Vui lòng chọn một chuyên mục hợp lệ.';
                        errorCategory.classList.remove('d-none');
                    }
                    hasClientError = true;
                }

                if (title && title.length > 400) {
                    inputTitle?.classList.add('is-invalid');
                    if (errorTitle) {
                        errorTitle.textContent = 'Tiêu đề bài viết không được vượt quá 400 ký tự.';
                        errorTitle.classList.remove('d-none');
                    }
                    hasClientError = true;
                }

                if (source && source.length > 400) {
                    inputSource?.classList.add('is-invalid');
                    if (errorSource) {
                        errorSource.textContent = 'Nguồn tin không được vượt quá 400 ký tự.';
                        errorSource.classList.remove('d-none');
                    }
                    hasClientError = true;
                }

                if (contentText && contentText.length > 4000) {
                    inputContent?.classList.add('is-invalid');
                    if (errorContent) {
                        errorContent.textContent = 'Nội dung bài viết không được vượt quá 4000 ký tự.';
                        errorContent.classList.remove('d-none');
                    }
                    hasClientError = true;
                }

                if (hasClientError) return;

                // Chuẩn bị gửi AJAX
                const tokenEl = formCreate.querySelector('input[name="__RequestVerificationToken"]');
                const token = tokenEl ? tokenEl.value : '';

                const payload = {
                    headline: headline,
                    newsTitle: title || null,
                    categoryId: categoryId,
                    newsStatus: status,
                    newsSource: source || null,
                    newsContent: contentText || null,
                    tagIds: tagIds
                };

                // Bật spinner
                if (btnSubmitCreate) btnSubmitCreate.disabled = true;
                if (spinnerCreate) spinnerCreate.classList.remove('d-none');
                if (btnTextCreate) btnTextCreate.innerHTML = '<i class="bi bi-save me-1"></i>Đang lưu...';

                try {
                    const response = await fetch('/staff/news?handler=Create', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token,
                            'Accept': 'application/json'
                        },
                        body: JSON.stringify(payload)
                    });

                    const result = await response.json();

                    if (result && result.success && result.article) {
                        const a = result.article;
                        createModal?.hide();
                        resetCreateForm();
                        showToast(true, result.message || 'Tạo bài viết mới thành công.');

                        // Xóa dòng rỗng nếu đang hiển thị
                        const emptyRow = document.getElementById('rowEmptyNews');
                        if (emptyRow) emptyRow.remove();

                        // Cập nhật DOM: Chèn bài viết mới vào đầu danh sách (AC 7)
                        const tbody = document.getElementById('tableNewsBody');
                        if (tbody) {
                            const newRow = document.createElement('tr');
                            newRow.id = `row-news-${a.newsArticleId}`;
                            newRow.className = 'table-success-subtle'; // Highlight nhẹ bài mới

                            // Tags html
                            let tagsHtml = '<span class="text-muted small">—</span>';
                            if (a.tags && a.tags.length > 0) {
                                const tagBadges = a.tags.slice(0, 3).map(t =>
                                    `<span class="badge bg-light text-dark border px-2 py-0 small">#${escapeHtml(t.tagName)}</span>`
                                ).join(' ');
                                const moreBadge = a.tags.length > 3 ? `<span class="badge bg-secondary-subtle text-secondary border px-1 py-0 small">+${a.tags.length - 3}</span>` : '';
                                tagsHtml = `<div class="d-flex flex-wrap gap-1">${tagBadges} ${moreBadge}</div>`;
                            }

                            // Status badge
                            const statusBadge = a.newsStatus === true
                                ? '<span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1"><i class="bi bi-check-circle-fill me-1"></i>Đang hiển thị</span>'
                                : '<span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1"><i class="bi bi-eye-slash-fill me-1"></i>Tạm ẩn</span>';

                            const formattedDate = a.createdDate ? new Date(a.createdDate).toLocaleString('vi-VN') : 'Vừa xong';

                            newRow.innerHTML = `
                                <td class="text-center fw-semibold text-muted small">
                                    <span class="badge bg-light text-dark border">${escapeHtml(a.newsArticleId)}</span>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark mb-1 lh-sm">${escapeHtml(a.newsTitle || 'Không có tiêu đề')}</div>
                                    <div class="text-secondary small text-truncate" style="max-width: 320px;" title="${escapeHtml(a.headline)}">${escapeHtml(a.headline)}</div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        <i class="bi bi-folder text-primary me-1"></i>${escapeHtml(a.categoryName || 'Chưa phân loại')}
                                    </span>
                                </td>
                                <td>
                                    <span class="small fw-semibold text-secondary">
                                        <i class="bi bi-person text-secondary me-1"></i>${escapeHtml(a.authorName || 'Chưa ghi nhận')}
                                    </span>
                                </td>
                                <td class="small text-muted">${formattedDate}</td>
                                <td class="text-center">${statusBadge}</td>
                                <td>${tagsHtml}</td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-1">
                                        <button type="button" class="btn btn-outline-primary btn-sm btn-view-news"
                                                data-news-id="${escapeHtml(a.newsArticleId)}"
                                                title="Xem chi tiết bài viết">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <button type="button" class="btn btn-outline-warning btn-sm btn-edit-news"
                                                data-news-id="${escapeHtml(a.newsArticleId)}"
                                                title="Sửa bài viết">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button type="button" class="btn btn-outline-danger btn-sm btn-delete-news"
                                                data-news-id="${escapeHtml(a.newsArticleId)}"
                                                data-news-title="${escapeHtml(a.newsTitle || a.headline)}"
                                                title="Xóa bài viết">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            `;

                            tbody.prepend(newRow);
                            bindDetailButtons(newRow);
                            bindEditButtons(newRow);
                            bindDeleteButtons(newRow);

                            // Cập nhật tổng số bài trên badge
                            const badgeTotal = document.getElementById('badgeTotalNewsCount');
                            if (badgeTotal) {
                                const currentTotal = parseInt(badgeTotal.textContent) || 0;
                                badgeTotal.textContent = (currentTotal + 1).toString();
                            }
                        }
                    } else {
                        // Xử lý lỗi validation từ server
                        const msg = (result && result.message) ? result.message : 'Không thể lưu bài viết. Vui lòng kiểm tra lại.';
                        if (alertCreate && alertCreateText) {
                            alertCreateText.textContent = msg;
                            alertCreate.classList.remove('d-none');
                        }

                        if (result && result.errors) {
                            for (const [key, errList] of Object.entries(result.errors)) {
                                const lowerKey = key.toLowerCase();
                                const firstError = Array.isArray(errList) ? errList[0] : errList;

                                if (lowerKey.includes('headline')) {
                                    inputHeadline?.classList.add('is-invalid');
                                    if (errorHeadline) {
                                        errorHeadline.textContent = firstError;
                                        errorHeadline.classList.remove('d-none');
                                    }
                                } else if (lowerKey.includes('category')) {
                                    selectCategory?.classList.add('is-invalid');
                                    if (errorCategory) {
                                        errorCategory.textContent = firstError;
                                        errorCategory.classList.remove('d-none');
                                    }
                                } else if (lowerKey.includes('title')) {
                                    inputTitle?.classList.add('is-invalid');
                                    if (errorTitle) {
                                        errorTitle.textContent = firstError;
                                        errorTitle.classList.remove('d-none');
                                    }
                                } else if (lowerKey.includes('source')) {
                                    inputSource?.classList.add('is-invalid');
                                    if (errorSource) {
                                        errorSource.textContent = firstError;
                                        errorSource.classList.remove('d-none');
                                    }
                                } else if (lowerKey.includes('tag')) {
                                    if (errorTags) {
                                        errorTags.textContent = firstError;
                                        errorTags.classList.remove('d-none');
                                    }
                                } else if (lowerKey.includes('content')) {
                                    inputContent?.classList.add('is-invalid');
                                    if (errorContent) {
                                        errorContent.textContent = firstError;
                                        errorContent.classList.remove('d-none');
                                    }
                                }
                            }
                        }

                        showToast(false, msg);
                    }
                } catch (err) {
                    const errorMsg = 'Lỗi kết nối khi gửi yêu cầu tạo bài viết.';
                    if (alertCreate && alertCreateText) {
                        alertCreateText.textContent = errorMsg;
                        alertCreate.classList.remove('d-none');
                    }
                    showToast(false, errorMsg);
                } finally {
                    if (btnSubmitCreate) btnSubmitCreate.disabled = false;
                    if (spinnerCreate) spinnerCreate.classList.add('d-none');
                    if (btnTextCreate) btnTextCreate.innerHTML = '<i class="bi bi-save me-1"></i>Lưu bài viết';
                }
            });

            function escapeHtml(text) {
                if (!text) return '';
                const div = document.createElement('div');
                div.textContent = text;
                return div.innerHTML;
            }

            // ==========================================
            // MODAL SỬA BÀI VIẾT (FUN-013)
            // ==========================================
            const modalEditEl = document.getElementById('modalEditNews');
            const editModal = modalEditEl ? new bootstrap.Modal(modalEditEl) : null;

            const editArticleIdInput = document.getElementById('editNewsArticleId');
            const editHeadlineInput = document.getElementById('editNewsHeadline');
            const editTitleInput = document.getElementById('editNewsTitle');
            const editCategorySelect = document.getElementById('editNewsCategory');
            const editStatusSelect = document.getElementById('editNewsStatus');
            const editSourceInput = document.getElementById('editNewsSource');
            const editContentTextarea = document.getElementById('editNewsContent');
            const editAlert = document.getElementById('editNewsAlert');
            const editAlertText = document.getElementById('editNewsAlertText');
            const editSpinnerLoad = document.getElementById('spinnerEditNews');
            const editFormContent = document.getElementById('formEditNewsContent');
            const btnSubmitEdit = document.getElementById('btnSubmitEditNews');
            const spinnerEdit = document.getElementById('spinnerEditNews2');
            const btnTextEdit = document.getElementById('btnTextEditNews');
            const formEdit = document.getElementById('formEditNews');

            // Counter helpers for edit modal
            function setupEditCounter(input, countEl, max) {
                if (!input || !countEl) return;
                countEl.textContent = input.value.length;
                input.addEventListener('input', () => {
                    countEl.textContent = input.value.length;
                });
            }
            setupEditCounter(editHeadlineInput, document.getElementById('editNewsHeadlineCount'), 150);
            setupEditCounter(editTitleInput, document.getElementById('editNewsTitleCount'), 400);
            setupEditCounter(editSourceInput, document.getElementById('editNewsSourceCount'), 400);
            setupEditCounter(editContentTextarea, document.getElementById('editNewsContentCount'), 4000);

            function clearEditErrors() {
                const fields = [editHeadlineInput, editTitleInput, editCategorySelect, editSourceInput, editContentTextarea];
                fields.forEach(f => f?.classList.remove('is-invalid'));
                ['errorEditNewsHeadline', 'errorEditNewsTitle', 'errorEditNewsCategory', 'errorEditNewsSource', 'errorEditNewsContent']
                    .forEach(id => {
                        const el = document.getElementById(id);
                        if (el) el.classList.add('d-none');
                    });
                if (editAlert) editAlert.classList.add('d-none');
            }

            function resetEditForm() {
                clearEditErrors();
                if (formEdit) formEdit.reset();
                if (editArticleIdInput) editArticleIdInput.value = '';
                // Reset tag checkboxes
                document.querySelectorAll('.edit-news-tag-cb').forEach(cb => cb.checked = false);
                // Reset counters
                ['editNewsHeadlineCount', 'editNewsTitleCount', 'editNewsSourceCount', 'editNewsContentCount']
                    .forEach(id => { const el = document.getElementById(id); if (el) el.textContent = '0'; });
                // Show spinner, hide form
                if (editSpinnerLoad) editSpinnerLoad.classList.remove('d-none');
                if (editFormContent) editFormContent.classList.add('d-none');
                if (btnSubmitEdit) btnSubmitEdit.disabled = false;
                if (spinnerEdit) spinnerEdit.classList.add('d-none');
                if (btnTextEdit) btnTextEdit.innerHTML = '<i class="bi bi-save me-1"></i>Lưu thay đổi';
            }

            modalEditEl?.addEventListener('hidden.bs.modal', resetEditForm);

            function bindEditButtons(container = document) {
                container.querySelectorAll('.btn-edit-news').forEach(btn => {
                    if (btn.hasAttribute('data-edit-bound')) return;
                    btn.setAttribute('data-edit-bound', 'true');

                    btn.addEventListener('click', async function () {
                        const newsId = this.getAttribute('data-news-id');
                        if (!newsId) return;

                        resetEditForm();
                        editModal?.show();

                        try {
                            const response = await fetch(`/staff/news?handler=Detail&id=${encodeURIComponent(newsId)}`, {
                                headers: { 'Accept': 'application/json' }
                            });
                            const result = await response.json();

                            if (result && result.success && result.article) {
                                const a = result.article;

                                // Pre-fill hidden ID
                                if (editArticleIdInput) editArticleIdInput.value = a.newsArticleId;

                                // Pre-fill text fields
                                if (editHeadlineInput) { editHeadlineInput.value = a.headline || ''; document.getElementById('editNewsHeadlineCount').textContent = editHeadlineInput.value.length; }
                                if (editTitleInput) { editTitleInput.value = a.newsTitle || ''; document.getElementById('editNewsTitleCount').textContent = editTitleInput.value.length; }
                                if (editSourceInput) { editSourceInput.value = a.newsSource || ''; document.getElementById('editNewsSourceCount').textContent = editSourceInput.value.length; }
                                if (editContentTextarea) { editContentTextarea.value = a.newsContent || ''; document.getElementById('editNewsContentCount').textContent = editContentTextarea.value.length; }

                                // Pre-fill category
                                if (editCategorySelect && a.categoryId) {
                                    editCategorySelect.value = a.categoryId.toString();
                                }

                                // Pre-fill status
                                if (editStatusSelect) {
                                    editStatusSelect.value = a.newsStatus === true ? 'true' : 'false';
                                }

                                // Pre-tick tags
                                document.querySelectorAll('.edit-news-tag-cb').forEach(cb => {
                                    const tagId = parseInt(cb.value);
                                    cb.checked = a.tags && a.tags.some(t => t.tagId === tagId);
                                });

                                // Show form, hide spinner
                                if (editSpinnerLoad) editSpinnerLoad.classList.add('d-none');
                                if (editFormContent) editFormContent.classList.remove('d-none');
                            } else {
                                const msg = result?.message || 'Không thể tải dữ liệu bài viết để sửa.';
                                if (editAlertText) editAlertText.textContent = msg;
                                if (editAlert) editAlert.classList.remove('d-none');
                                if (editSpinnerLoad) editSpinnerLoad.classList.add('d-none');
                            }
                        } catch (err) {
                            if (editAlertText) editAlertText.textContent = 'Lỗi kết nối khi tải dữ liệu bài viết.';
                            if (editAlert) editAlert.classList.remove('d-none');
                            if (editSpinnerLoad) editSpinnerLoad.classList.add('d-none');
                        }
                    });
                });
            }
            bindEditButtons();

            formEdit?.addEventListener('submit', async function (e) {
                e.preventDefault();
                clearEditErrors();

                const articleId = editArticleIdInput?.value?.trim();
                const headline = editHeadlineInput ? editHeadlineInput.value.trim() : '';
                const title = editTitleInput ? editTitleInput.value.trim() : '';
                const categoryId = editCategorySelect ? parseInt(editCategorySelect.value) : 0;
                const status = editStatusSelect ? (editStatusSelect.value === 'true') : true;
                const source = editSourceInput ? editSourceInput.value.trim() : '';
                const contentText = editContentTextarea ? editContentTextarea.value.trim() : '';
                const tagCheckboxes = document.querySelectorAll('.edit-news-tag-cb:checked');
                const tagIds = Array.from(tagCheckboxes).map(cb => parseInt(cb.value)).filter(v => !isNaN(v) && v > 0);

                // Client-side validation
                let hasError = false;
                if (!headline) {
                    editHeadlineInput?.classList.add('is-invalid');
                    const el = document.getElementById('errorEditNewsHeadline');
                    if (el) { el.textContent = 'Tiêu đề tóm tắt là bắt buộc.'; el.classList.remove('d-none'); }
                    hasError = true;
                } else if (headline.length > 150) {
                    editHeadlineInput?.classList.add('is-invalid');
                    const el = document.getElementById('errorEditNewsHeadline');
                    if (el) { el.textContent = 'Tiêu đề tóm tắt không được vượt quá 150 ký tự.'; el.classList.remove('d-none'); }
                    hasError = true;
                }
                if (!categoryId || isNaN(categoryId) || categoryId <= 0) {
                    editCategorySelect?.classList.add('is-invalid');
                    const el = document.getElementById('errorEditNewsCategory');
                    if (el) { el.textContent = 'Vui lòng chọn một chuyên mục hợp lệ.'; el.classList.remove('d-none'); }
                    hasError = true;
                }
                if (hasError) return;

                const tokenEl = formEdit.querySelector('input[name="__RequestVerificationToken"]');
                const token = tokenEl ? tokenEl.value : '';

                const payload = {
                    newsArticleId: articleId,
                    headline: headline,
                    newsTitle: title || null,
                    categoryId: categoryId,
                    newsStatus: status,
                    newsSource: source || null,
                    newsContent: contentText || null,
                    tagIds: tagIds
                };

                if (btnSubmitEdit) btnSubmitEdit.disabled = true;
                if (spinnerEdit) spinnerEdit.classList.remove('d-none');
                if (btnTextEdit) btnTextEdit.innerHTML = '<i class="bi bi-save me-1"></i>Đang lưu...';

                try {
                    const response = await fetch('/staff/news?handler=Update', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token,
                            'Accept': 'application/json'
                        },
                        body: JSON.stringify(payload)
                    });
                    const result = await response.json();

                    if (result && result.success && result.article) {
                        const a = result.article;
                        editModal?.hide();
                        resetEditForm();
                        showToast(true, result.message || 'Cập nhật bài viết thành công.');

                        // Cập nhật dòng trong bảng
                        const row = document.getElementById(`row-news-${a.newsArticleId}`);
                        if (row) {
                            // Cập nhật tiêu đề & headline
                            const titleDiv = row.querySelector('td:nth-child(2) .fw-semibold');
                            if (titleDiv) titleDiv.textContent = a.newsTitle || 'Không có tiêu đề';
                            const headlineDiv = row.querySelector('td:nth-child(2) .text-secondary');
                            if (headlineDiv) headlineDiv.textContent = a.headline;

                            // Cập nhật chuyên mục
                            const catBadge = row.querySelector('td:nth-child(3) .badge');
                            if (catBadge) catBadge.innerHTML = `<i class="bi bi-folder text-primary me-1"></i>${escapeHtml(a.categoryName || 'Chưa phân loại')}`;

                            // Cập nhật trạng thái
                            const statusTd = row.querySelector('td:nth-child(6)');
                            if (statusTd) {
                                statusTd.innerHTML = a.newsStatus === true
                                    ? '<span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1"><i class="bi bi-check-circle-fill me-1"></i>Đang hiển thị</span>'
                                    : '<span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1"><i class="bi bi-eye-slash-fill me-1"></i>Tạm ẩn</span>';
                            }

                            // Cập nhật tags
                            const tagsTd = row.querySelector('td:nth-child(7)');
                            if (tagsTd) {
                                if (a.tags && a.tags.length > 0) {
                                    const tagBadges = a.tags.slice(0, 3).map(t => `<span class="badge bg-light text-dark border px-2 py-0 small">#${escapeHtml(t.tagName)}</span>`).join(' ');
                                    const moreBadge = a.tags.length > 3 ? `<span class="badge bg-secondary-subtle text-secondary border px-1 py-0 small">+${a.tags.length - 3}</span>` : '';
                                    tagsTd.innerHTML = `<div class="d-flex flex-wrap gap-1">${tagBadges} ${moreBadge}</div>`;
                                } else {
                                    tagsTd.innerHTML = '<span class="text-muted small">—</span>';
                                }
                            }
                        }
                    } else {
                        const msg = result?.message || 'Không thể cập nhật bài viết.';
                        if (editAlertText) editAlertText.textContent = msg;
                        if (editAlert) editAlert.classList.remove('d-none');
                        showToast(false, msg);
                    }
                } catch (err) {
                    const msg = 'Lỗi kết nối khi gửi yêu cầu cập nhật bài viết.';
                    if (editAlertText) editAlertText.textContent = msg;
                    if (editAlert) editAlert.classList.remove('d-none');
                    showToast(false, msg);
                } finally {
                    if (btnSubmitEdit) btnSubmitEdit.disabled = false;
                    if (spinnerEdit) spinnerEdit.classList.add('d-none');
                    if (btnTextEdit) btnTextEdit.innerHTML = '<i class="bi bi-save me-1"></i>Lưu thay đổi';
                }
            });

            // ==========================================
            // MODAL XÓA BÀI VIẾT (FUN-013)
            // ==========================================
            const modalDeleteEl = document.getElementById('modalDeleteNews');
            const deleteModal = modalDeleteEl ? new bootstrap.Modal(modalDeleteEl) : null;
            const deleteArticleIdInput = document.getElementById('deleteNewsArticleId');
            const deleteTitleEl = document.getElementById('deleteNewsTitle');
            const deleteIdDisplay = document.getElementById('deleteNewsIdDisplay');
            const btnConfirmDelete = document.getElementById('btnConfirmDeleteNews');
            const spinnerDeleteNews = document.getElementById('spinnerDeleteNews');
            const btnTextDelete = document.getElementById('btnTextDeleteNews');

            function bindDeleteButtons(container = document) {
                container.querySelectorAll('.btn-delete-news').forEach(btn => {
                    if (btn.hasAttribute('data-delete-bound')) return;
                    btn.setAttribute('data-delete-bound', 'true');

                    btn.addEventListener('click', function () {
                        const newsId = this.getAttribute('data-news-id');
                        const newsTitle = this.getAttribute('data-news-title') || '—';
                        if (!newsId) return;

                        if (deleteArticleIdInput) deleteArticleIdInput.value = newsId;
                        if (deleteTitleEl) deleteTitleEl.textContent = newsTitle;
                        if (deleteIdDisplay) deleteIdDisplay.textContent = newsId;
                        deleteModal?.show();
                    });
                });
            }
            bindDeleteButtons();

            btnConfirmDelete?.addEventListener('click', async function () {
                const articleId = deleteArticleIdInput?.value;
                if (!articleId) return;

                if (btnConfirmDelete) btnConfirmDelete.disabled = true;
                if (spinnerDeleteNews) spinnerDeleteNews.classList.remove('d-none');
                if (btnTextDelete) btnTextDelete.innerHTML = '<i class="bi bi-trash me-1"></i>Đang xóa...';

                const tokenEl = document.querySelector('form input[name="__RequestVerificationToken"]');
                const token = tokenEl ? tokenEl.value : '';

                try {
                    const response = await fetch('/staff/news?handler=Delete', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token,
                            'Accept': 'application/json'
                        },
                        body: JSON.stringify({ newsArticleId: articleId })
                    });
                    const result = await response.json();

                    if (result && result.success) {
                        deleteModal?.hide();
                        showToast(true, result.message || 'Đã xóa bài viết thành công.');

                        // Xóa dòng khỏi bảng
                        const row = document.getElementById(`row-news-${articleId}`);
                        if (row) row.remove();

                        // Cập nhật badge tổng
                        const badgeTotal = document.getElementById('badgeTotalNewsCount');
                        if (badgeTotal) {
                            const current = parseInt(badgeTotal.textContent) || 0;
                            badgeTotal.textContent = Math.max(0, current - 1).toString();
                        }

                        // Hiện dòng trống nếu không còn bài nào
                        const tbody = document.getElementById('tableNewsBody');
                        if (tbody && tbody.querySelectorAll('tr').length === 0) {
                            const emptyRow = document.createElement('tr');
                            emptyRow.id = 'rowEmptyNews';
                            emptyRow.innerHTML = '<td colspan="8" class="text-center py-5 text-muted"><i class="bi bi-newspaper fs-1 d-block mb-2 text-secondary"></i><span>Không tìm thấy bài viết tin tức nào phù hợp với điều kiện tìm kiếm.</span></td>';
                            tbody.appendChild(emptyRow);
                        }
                    } else {
                        const msg = result?.message || 'Không thể xóa bài viết. Vui lòng thử lại.';
                        showToast(false, msg);
                    }
                } catch (err) {
                    showToast(false, 'Lỗi kết nối khi gửi yêu cầu xóa bài viết.');
                } finally {
                    if (btnConfirmDelete) btnConfirmDelete.disabled = false;
                    if (spinnerDeleteNews) spinnerDeleteNews.classList.add('d-none');
                    if (btnTextDelete) btnTextDelete.innerHTML = '<i class="bi bi-trash me-1"></i>Xóa bài viết';
                }
            });
        });

        function changePageSize(size) {
            const url = new URL(window.location.href);
            url.searchParams.set('pageSize', size);
            url.searchParams.set('pageIndex', '1');
            window.location.href = url.toString();
        }
    </script>
}

