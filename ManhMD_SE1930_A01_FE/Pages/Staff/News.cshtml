@page "/staff/news"
@model ManhMD_SE1930_A01_FE.Pages.Staff.NewsModel
@{
    ViewData["Title"] = "Quản lý bài viết tin tức";

    // Helper tính toán phân trang
    int startItem = Model.TotalCount > 0 ? (Model.PageIndex - 1) * Model.PageSize + 1 : 0;
    int endItem = Math.Min(Model.PageIndex * Model.PageSize, Model.TotalCount);

    // Route dictionary để giữ filter khi click phân trang
    var routeParams = new Dictionary<string, string>();
    if (!string.IsNullOrWhiteSpace(Model.SearchTerm)) routeParams["searchTerm"] = Model.SearchTerm;
    if (Model.CategoryId.HasValue) routeParams["categoryId"] = Model.CategoryId.Value.ToString();
    if (!string.IsNullOrWhiteSpace(Model.StatusFilter)) routeParams["statusFilter"] = Model.StatusFilter;
    if (!string.IsNullOrWhiteSpace(Model.AuthorTerm)) routeParams["authorTerm"] = Model.AuthorTerm;
    if (Model.StartDate.HasValue) routeParams["startDate"] = Model.StartDate.Value.ToString("yyyy-MM-dd");
    if (Model.EndDate.HasValue) routeParams["endDate"] = Model.EndDate.Value.ToString("yyyy-MM-dd");
    if (!string.IsNullOrWhiteSpace(Model.SortBy)) routeParams["sortBy"] = Model.SortBy;
    if (Model.PageSize != 10) routeParams["pageSize"] = Model.PageSize.ToString();
}

<div class="container-fluid px-4 py-3">
    <!-- Breadcrumb & Header -->
    <nav aria-label="breadcrumb" class="mb-2">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-page="/Index" class="text-decoration-none">Trang chủ</a></li>
            <li class="breadcrumb-item active" aria-current="page">Quản lý bài viết</li>
        </ol>
    </nav>

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 pb-2 border-bottom">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-newspaper text-primary me-2"></i>Quản lý bài viết tin tức
            </h1>
            <p class="text-muted small mb-0">Tra cứu, lọc theo chuyên mục, tác giả, trạng thái và khoảng thời gian (Staff Only)</p>
        </div>
        <div class="d-flex align-items-center gap-2 mt-2 mt-md-0">
            <span class="badge bg-primary px-3 py-2 fs-6">
                <i class="bi bi-shield-check me-1"></i>Khu vực Staff
            </span>
            <span class="badge bg-light text-dark border px-3 py-2 fs-6">
                Tổng: <strong id="badgeTotalNewsCount">@Model.TotalCount</strong> bài
            </span>
        </div>
    </div>

    <!-- Thông báo lộ trình chức năng (AC 6: Không có CTA giả) -->
    <div class="alert alert-info py-2 px-3 mb-3 d-flex align-items-center justify-content-between shadow-sm">
        <div class="small">
            <i class="bi bi-info-circle-fill me-2 fs-6 text-info"></i>
            <span><strong>Tính năng hiện tại:</strong> Danh sách, tìm kiếm đa điều kiện, lọc khoảng ngày & phân trang ổn định. Các thao tác <em>Thêm bài viết mới [FUN-012]</em>, <em>Sửa & Xóa bài viết [FUN-013]</em>, <em>Nhân bản bài viết [FUN-014]</em> sẽ được kết nối ở các task kế tiếp.</span>
        </div>
    </div>

    <!-- Thông báo lỗi nếu có -->
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <span>@Model.ErrorMessage</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- ======================================================== -->
    <!-- BỘ LỌC TÌM KIẾM ĐA ĐIỀU KIỆN (SEARCH & FILTERS TOOLBAR)  -->
    <!-- ======================================================== -->
    <div class="card shadow-sm border-0 mb-4 bg-white">
        <div class="card-body p-3 p-md-4">
            <form method="get" id="formFilterNews" class="needs-validation" novalidate>
                <div class="row g-3">
                    <!-- 1. Từ khóa tiêu đề/tóm tắt -->
                    <div class="col-12 col-md-4">
                        <label for="inputSearchTerm" class="form-label small fw-semibold text-secondary mb-1">
                            <i class="bi bi-search me-1"></i>Từ khóa bài viết
                        </label>
                        <input type="text" class="form-control form-control-sm" id="inputSearchTerm" name="searchTerm"
                               placeholder="Tìm theo tiêu đề hoặc tóm tắt..." value="@Model.SearchTerm" maxlength="150" />
                    </div>

                    <!-- 2. Chuyên mục -->
                    <div class="col-12 col-sm-6 col-md-3">
                        <label for="selectCategory" class="form-label small fw-semibold text-secondary mb-1">
                            <i class="bi bi-folder2-open me-1"></i>Chuyên mục
                        </label>
                        <select class="form-select form-select-sm" id="selectCategory" name="categoryId">
                            <option value="">-- Tất cả chuyên mục --</option>
                            @foreach (var cat in Model.Categories)
                            {
                                <option value="@cat.CategoryId" selected="@(Model.CategoryId == cat.CategoryId)">
                                    @cat.CategoryName @(cat.IsActive == false ? "(Tạm ẩn)" : "")
                                </option>
                            }
                        </select>
                    </div>

                    <!-- 3. Tác giả -->
                    <div class="col-12 col-sm-6 col-md-3">
                        <label for="inputAuthor" class="form-label small fw-semibold text-secondary mb-1">
                            <i class="bi bi-person me-1"></i>Tác giả
                        </label>
                        <input type="text" class="form-control form-control-sm" id="inputAuthor" name="authorTerm"
                               placeholder="Tên tác giả..." value="@Model.AuthorTerm" maxlength="100" />
                    </div>

                    <!-- 4. Trạng thái -->
                    <div class="col-12 col-sm-6 col-md-2">
                        <label for="selectStatus" class="form-label small fw-semibold text-secondary mb-1">
                            <i class="bi bi-toggle-on me-1"></i>Trạng thái
                        </label>
                        <select class="form-select form-select-sm" id="selectStatus" name="statusFilter">
                            <option value="">-- Tất cả --</option>
                            <option value="active" selected="@(string.Equals(Model.StatusFilter, "active", StringComparison.OrdinalIgnoreCase))">Đang hiển thị</option>
                            <option value="inactive" selected="@(string.Equals(Model.StatusFilter, "inactive", StringComparison.OrdinalIgnoreCase))">Tạm ẩn</option>
                        </select>
                    </div>

                    <!-- 5. Khoảng ngày: Từ ngày (AC 3: Date Inclusive) -->
                    <div class="col-12 col-sm-6 col-md-3">
                        <label for="inputStartDate" class="form-label small fw-semibold text-secondary mb-1">
                            <i class="bi bi-calendar-event me-1"></i>Từ ngày tạo
                        </label>
                        <input type="date" class="form-control form-control-sm" id="inputStartDate" name="startDate"
                               value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" />
                    </div>

                    <!-- 6. Khoảng ngày: Đến ngày (AC 3: Date Inclusive) -->
                    <div class="col-12 col-sm-6 col-md-3">
                        <label for="inputEndDate" class="form-label small fw-semibold text-secondary mb-1">
                            <i class="bi bi-calendar-check me-1"></i>Đến ngày tạo
                        </label>
                        <input type="date" class="form-control form-control-sm" id="inputEndDate" name="endDate"
                               value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" />
                    </div>

                    <!-- 7. Sắp xếp (AC 4: Sort ổn định) -->
                    <div class="col-12 col-sm-6 col-md-3">
                        <label for="selectSortBy" class="form-label small fw-semibold text-secondary mb-1">
                            <i class="bi bi-sort-down me-1"></i>Sắp xếp theo
                        </label>
                        <select class="form-select form-select-sm" id="selectSortBy" name="sortBy">
                            <option value="date_desc" selected="@(Model.SortBy == "date_desc" || string.IsNullOrEmpty(Model.SortBy))">Ngày tạo mới nhất</option>
                            <option value="date_asc" selected="@(Model.SortBy == "date_asc")">Ngày tạo cũ nhất</option>
                            <option value="title_asc" selected="@(Model.SortBy == "title_asc")">Tiêu đề (A - Z)</option>
                            <option value="title_desc" selected="@(Model.SortBy == "title_desc")">Tiêu đề (Z - A)</option>
                        </select>
                    </div>

                    <!-- 8. Thao tác lọc và reset -->
                    <div class="col-12 col-sm-6 col-md-3 d-flex align-items-end gap-2">
                        <button type="submit" class="btn btn-primary btn-sm px-3 flex-grow-1" id="btnFilterNews">
                            <i class="bi bi-funnel me-1"></i>Áp dụng lọc
                        </button>
                        <a asp-page="/Staff/News" class="btn btn-outline-secondary btn-sm px-3" title="Xóa tất cả bộ lọc">
                            <i class="bi bi-arrow-counterclockwise me-1"></i>Đặt lại
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- ======================================================== -->
    <!-- BẢNG DANH SÁCH BÀI VIẾT TIN TỨC (NEWS TABLE)             -->
    <!-- ======================================================== -->
    <div class="card shadow-sm border-0 bg-white">
        <div class="card-header bg-light py-2 px-3 d-flex flex-wrap justify-content-between align-items-center">
            <span class="small fw-semibold text-secondary">
                <i class="bi bi-table me-1"></i>Danh sách bài viết (@startItem–@endItem trong @Model.TotalCount bài)
            </span>
            <div class="d-flex align-items-center gap-2">
                <span class="small text-muted d-none d-sm-inline">Hiển thị mỗi trang:</span>
                <select class="form-select form-select-sm py-0" style="width: auto;" id="selectPageSize" onchange="changePageSize(this.value)">
                    <option value="10" selected="@(Model.PageSize == 10)">10 bài</option>
                    <option value="20" selected="@(Model.PageSize == 20)">20 bài</option>
                    <option value="50" selected="@(Model.PageSize == 50)">50 bài</option>
                </select>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="tableNewsArticles">
                <thead class="table-light">
                    <tr>
                        <th scope="col" style="width: 110px;" class="text-center">Mã bài</th>
                        <th scope="col" style="min-width: 250px;">Tiêu đề & Tóm tắt</th>
                        <th scope="col" style="width: 150px;">Chuyên mục</th>
                        <th scope="col" style="width: 140px;">Tác giả</th>
                        <th scope="col" style="width: 130px;">Ngày tạo</th>
                        <th scope="col" style="width: 120px;" class="text-center">Trạng thái</th>
                        <th scope="col" style="width: 180px;">Thẻ tin (Tags)</th>
                        <th scope="col" style="width: 100px;" class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody id="tableNewsBody">
                    @if (Model.NewsArticles == null || Model.NewsArticles.Count == 0)
                    {
                        <tr id="rowEmptyNews">
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-newspaper fs-1 d-block mb-2 text-secondary"></i>
                                <span>Không tìm thấy bài viết tin tức nào phù hợp với điều kiện tìm kiếm.</span>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var article in Model.NewsArticles)
                        {
                            <tr id="row-news-@article.NewsArticleId">
                                <!-- Mã bài viết -->
                                <td class="text-center fw-semibold text-muted small">
                                    <span class="badge bg-light text-dark border">@article.NewsArticleId</span>
                                </td>

                                <!-- Tiêu đề & Tóm tắt -->
                                <td>
                                    <div class="fw-semibold text-dark mb-1 lh-sm">
                                        @article.NewsTitle
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(article.Headline))
                                    {
                                        <div class="text-secondary small text-truncate" style="max-width: 320px;" title="@article.Headline">
                                            @article.Headline
                                        </div>
                                    }
                                </td>

                                <!-- Chuyên mục (AC 2) -->
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(article.CategoryName))
                                    {
                                        <span class="badge bg-light text-dark border">
                                            <i class="bi bi-folder text-primary me-1"></i>@article.CategoryName
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>

                                <!-- Tác giả (AC 2) -->
                                <td>
                                    <span class="small fw-semibold text-secondary">
                                        <i class="bi bi-person text-secondary me-1"></i>@(string.IsNullOrWhiteSpace(article.AuthorName) ? "Chưa ghi nhận" : article.AuthorName)
                                    </span>
                                </td>

                                <!-- Ngày tạo -->
                                <td class="small text-muted">
                                    @(article.CreatedDate?.ToString("dd/MM/yyyy HH:mm") ?? "—")
                                </td>

                                <!-- Trạng thái (Active / Inactive) -->
                                <td class="text-center">
                                    @if (article.NewsStatus == true)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                            <i class="bi bi-check-circle-fill me-1"></i>Đang hiển thị
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">
                                            <i class="bi bi-eye-slash-fill me-1"></i>Tạm ẩn
                                        </span>
                                    }
                                </td>

                                <!-- Thẻ tin (Tags) -->
                                <td>
                                    @if (article.Tags != null && article.Tags.Count > 0)
                                    {
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var tag in article.Tags.Take(3))
                                            {
                                                <span class="badge bg-light text-dark border px-2 py-0 small">
                                                    #@tag.TagName
                                                </span>
                                            }
                                            @if (article.Tags.Count > 3)
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary border px-1 py-0 small" title="Còn @(article.Tags.Count - 3) thẻ khác">
                                                    +@(article.Tags.Count - 3)
                                                </span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>

                                <!-- Thao tác xem chi tiết (AC 6: Nối chức năng thật) -->
                                <td class="text-center">
                                    <button type="button" class="btn btn-outline-primary btn-sm btn-view-news"
                                            data-news-id="@article.NewsArticleId"
                                            title="Xem chi tiết bài viết">
                                        <i class="bi bi-eye me-1"></i>Chi tiết
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- ======================================================== -->
        <!-- PHÂN TRANG (PAGINATION)                                 -->
        <!-- ======================================================== -->
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-light py-2 px-3 d-flex flex-wrap justify-content-between align-items-center">
                <span class="small text-muted mb-2 mb-sm-0">
                    Trang <strong>@Model.PageIndex</strong> / <strong>@Model.TotalPages</strong>
                </span>

                <nav aria-label="News page navigation">
                    <ul class="pagination pagination-sm mb-0">
                        <!-- Nút trang trước -->
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            @{
                                var prevRoutes = new Dictionary<string, string>(routeParams) { ["pageIndex"] = (Model.PageIndex - 1).ToString() };
                            }
                            <a class="page-link" asp-page="/Staff/News" asp-all-route-data="@prevRoutes" aria-label="Previous">
                                <span aria-hidden="true">&laquo; Trang trước</span>
                            </a>
                        </li>

                        <!-- Các trang xung quanh -->
                        @for (int p = Math.Max(1, Model.PageIndex - 2); p <= Math.Min(Model.TotalPages, Model.PageIndex + 2); p++)
                        {
                            var pageRoutes = new Dictionary<string, string>(routeParams) { ["pageIndex"] = p.ToString() };
                            <li class="page-item @(p == Model.PageIndex ? "active" : "")">
                                <a class="page-link" asp-page="/Staff/News" asp-all-route-data="@pageRoutes">@p</a>
                            </li>
                        }

                        <!-- Nút trang sau -->
                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            @{
                                var nextRoutes = new Dictionary<string, string>(routeParams) { ["pageIndex"] = (Model.PageIndex + 1).ToString() };
                            }
                            <a class="page-link" asp-page="/Staff/News" asp-all-route-data="@nextRoutes" aria-label="Next">
                                <span aria-hidden="true">Trang sau &raquo;</span>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

<!-- ======================================================== -->
<!-- MODAL XEM CHI TIẾT BÀI VIẾT (AJAX - THẬT 100%)          -->
<!-- ======================================================== -->
<div class="modal fade" id="modalNewsDetail" tabindex="-1" aria-labelledby="modalNewsDetailLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content shadow border-0">
            <div class="modal-header bg-primary text-white py-3">
                <h5 class="modal-title h6 fw-bold mb-0" id="modalNewsDetailLabel">
                    <i class="bi bi-file-earmark-text me-2"></i>Chi tiết bài viết tin tức
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <!-- Spinner loading -->
                <div id="spinnerNewsDetail" class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Đang tải chi tiết...</span>
                    </div>
                    <div class="text-muted small mt-2">Đang tải dữ liệu bài viết...</div>
                </div>

                <!-- Error notice -->
                <div id="alertNewsDetailError" class="alert alert-danger d-none" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <span id="textNewsDetailError"></span>
                </div>

                <!-- Nội dung chi tiết bài viết -->
                <div id="contentNewsDetail" class="d-none">
                    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 pb-2 border-bottom">
                        <span class="badge bg-light text-dark border px-2 py-1 fs-6" id="detailNewsId">#ID</span>
                        <div id="detailNewsStatus"></div>
                    </div>

                    <h4 class="fw-bold text-dark mb-2" id="detailNewsTitle"></h4>
                    <p class="text-muted fw-semibold mb-3 fs-6" id="detailNewsHeadline"></p>

                    <div class="row g-2 p-3 bg-light rounded-3 mb-3 small">
                        <div class="col-sm-6">
                            <span class="text-secondary">Chuyên mục:</span>
                            <strong id="detailNewsCategory" class="ms-1 text-dark"></strong>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-secondary">Tác giả:</span>
                            <strong id="detailNewsAuthor" class="ms-1 text-dark"></strong>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-secondary">Ngày tạo:</span>
                            <span id="detailNewsCreatedDate" class="ms-1 text-dark"></span>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-secondary">Nguồn tin:</span>
                            <span id="detailNewsSource" class="ms-1 text-dark"></span>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-secondary">Lần sửa cuối:</span>
                            <span id="detailNewsModifiedDate" class="ms-1 text-dark"></span>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-secondary">Người sửa cuối:</span>
                            <span id="detailNewsLastEditor" class="ms-1 text-dark"></span>
                        </div>
                    </div>

                    <!-- Danh sách tags -->
                    <div class="mb-3">
                        <span class="small fw-semibold text-secondary d-block mb-1">
                            <i class="bi bi-tags me-1"></i>Thẻ tin tức liên kết:
                        </span>
                        <div id="detailNewsTags" class="d-flex flex-wrap gap-1"></div>
                    </div>

                    <!-- Nội dung bài viết -->
                    <div>
                        <span class="small fw-semibold text-secondary d-block mb-1">
                            <i class="bi bi-body-text me-1"></i>Nội dung bài viết:
                        </span>
                        <div class="p-3 border rounded-3 bg-white" style="white-space: pre-wrap; font-family: inherit; font-size: 0.95rem; line-height: 1.6;" id="detailNewsContent"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light py-2 px-3">
                <button type="button" class="btn btn-secondary btn-sm px-4" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Modal chi tiết
            const modalEl = document.getElementById('modalNewsDetail');
            const detailModal = modalEl ? new bootstrap.Modal(modalEl) : null;

            const spinner = document.getElementById('spinnerNewsDetail');
            const alertError = document.getElementById('alertNewsDetailError');
            const textError = document.getElementById('textNewsDetailError');
            const content = document.getElementById('contentNewsDetail');

            const idEl = document.getElementById('detailNewsId');
            const statusEl = document.getElementById('detailNewsStatus');
            const titleEl = document.getElementById('detailNewsTitle');
            const headlineEl = document.getElementById('detailNewsHeadline');
            const categoryEl = document.getElementById('detailNewsCategory');
            const authorEl = document.getElementById('detailNewsAuthor');
            const createdDateEl = document.getElementById('detailNewsCreatedDate');
            const sourceEl = document.getElementById('detailNewsSource');
            const modifiedDateEl = document.getElementById('detailNewsModifiedDate');
            const lastEditorEl = document.getElementById('detailNewsLastEditor');
            const tagsEl = document.getElementById('detailNewsTags');
            const bodyEl = document.getElementById('detailNewsContent');

            // Bắt sự kiện click nút xem chi tiết
            document.querySelectorAll('.btn-view-news').forEach(btn => {
                btn.addEventListener('click', async function () {
                    const newsId = this.getAttribute('data-news-id');
                    if (!newsId) return;

                    // Reset modal state
                    if (alertError) alertError.classList.add('d-none');
                    if (content) content.classList.add('d-none');
                    if (spinner) spinner.classList.remove('d-none');

                    detailModal?.show();

                    try {
                        const response = await fetch(`/staff/news?handler=Detail&id=${encodeURIComponent(newsId)}`, {
                            headers: { 'Accept': 'application/json' }
                        });
                        const result = await response.json();

                        if (result && result.success && result.article) {
                            const a = result.article;

                            if (idEl) idEl.textContent = `#${a.newsArticleId}`;
                            if (titleEl) titleEl.textContent = a.newsTitle || 'Không có tiêu đề';
                            if (headlineEl) headlineEl.textContent = a.headline || '—';
                            if (categoryEl) categoryEl.textContent = a.categoryName || 'Chưa phân loại';
                            if (authorEl) authorEl.textContent = a.authorName || 'Chưa ghi nhận';
                            if (sourceEl) sourceEl.textContent = a.newsSource || 'N/A';
                            if (createdDateEl) createdDateEl.textContent = a.createdDate ? new Date(a.createdDate).toLocaleString('vi-VN') : '—';
                            if (modifiedDateEl) modifiedDateEl.textContent = a.modifiedDate ? new Date(a.modifiedDate).toLocaleString('vi-VN') : 'Chưa chỉnh sửa';
                            if (lastEditorEl) lastEditorEl.textContent = a.lastEditorName || '—';

                            if (statusEl) {
                                if (a.newsStatus === true) {
                                    statusEl.innerHTML = `<span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1"><i class="bi bi-check-circle-fill me-1"></i>Đang hiển thị</span>`;
                                } else {
                                    statusEl.innerHTML = `<span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1"><i class="bi bi-eye-slash-fill me-1"></i>Tạm ẩn</span>`;
                                }
                            }

                            // Tags
                            if (tagsEl) {
                                if (a.tags && a.tags.length > 0) {
                                    tagsEl.innerHTML = a.tags.map(t =>
                                        `<span class="badge bg-light text-dark border px-2 py-1">#${escapeHtml(t.tagName)}</span>`
                                    ).join('');
                                } else {
                                    tagsEl.innerHTML = '<span class="text-muted small">Không có thẻ tin nào</span>';
                                }
                            }

                            // Content (Plain text an toàn)
                            if (bodyEl) {
                                bodyEl.textContent = a.newsContent || 'Không có nội dung.';
                            }

                            if (spinner) spinner.classList.add('d-none');
                            if (content) content.classList.remove('d-none');
                        } else {
                            const msg = (result && result.message) ? result.message : 'Không tìm thấy dữ liệu bài viết.';
                            if (textError) textError.textContent = msg;
                            if (spinner) spinner.classList.add('d-none');
                            if (alertError) alertError.classList.remove('d-none');
                        }
                    } catch (err) {
                        if (textError) textError.textContent = 'Lỗi kết nối khi tải chi tiết bài viết.';
                        if (spinner) spinner.classList.add('d-none');
                        if (alertError) alertError.classList.remove('d-none');
                    }
                });
            });

            function escapeHtml(text) {
                if (!text) return '';
                const div = document.createElement('div');
                div.textContent = text;
                return div.innerHTML;
            }
        });

        function changePageSize(size) {
            const url = new URL(window.location.href);
            url.searchParams.set('pageSize', size);
            url.searchParams.set('pageIndex', '1');
            window.location.href = url.toString();
        }
    </script>
}
