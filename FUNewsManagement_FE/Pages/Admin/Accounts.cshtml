                        </label>
                        <select class="form-select" id="editAccountRole" name="accountRole" required>
                            <option value="">-- Chọn vai trò người dùng --</option>
                            <option value="1">Nhân viên quản lý tin (Staff)</option>
                            <option value="2">Giảng viên xem tin (Lecturer)</option>
                        </select>
                        <div class="invalid-feedback" id="errorEditAccountRole">Vui lòng chọn vai trò hợp lệ (Nhân viên hoặc Giảng viên).</div>
                    </div>
                </div>

                <div class="modal-footer bg-light py-2 px-4">
                    <button type="button" class="btn btn-outline-secondary btn-sm px-3" data-bs-dismiss="modal" id="btnCancelEditModal">Hủy</button>
                    <button type="submit" class="btn btn-primary btn-sm px-4" id="btnSubmitEditAccount">
                        <span class="spinner-border spinner-border-sm me-1 d-none" id="spinnerEditAccount" role="status" aria-hidden="true"></span>
                        <span id="btnTextEditAccount">Lưu thay đổi</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Xác nhận xóa tài khoản -->
<div class="modal fade" id="modalDeleteAccount" tabindex="-1" aria-labelledby="modalDeleteAccountLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow">
            <div class="modal-header bg-danger text-white py-3">
                <h5 class="modal-title h6 fw-bold mb-0" id="modalDeleteAccountLabel">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Xác nhận xóa tài khoản
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" id="btnCloseDeleteModal"></button>
            </div>
            <form id="formDeleteAccount" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="deleteAccountId" name="id" />
                <div class="modal-body p-4">
                    <!-- Alert thông báo lỗi khi không thể xóa (ví dụ: đã tạo/sửa bài viết) -->
                    <div class="alert alert-danger d-none py-2 mb-3" id="deleteAccountAlert" role="alert">
                        <i class="bi bi-x-circle-fill me-2"></i>
                        <span id="deleteAccountAlertText"></span>
                    </div>

                    <p class="mb-2">Bạn có chắc chắn muốn xóa tài khoản người dùng sau đây không?</p>
                    <div class="card bg-light border-0 p-3 mb-3">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted small">Mã tài khoản:</span>
                            <span class="fw-bold text-dark font-monospace" id="deleteAccountDisplayId"></span>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted small">Họ và tên:</span>
                            <span class="fw-bold text-dark" id="deleteAccountDisplayName"></span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted small">Email:</span>
                            <span class="text-primary font-monospace small" id="deleteAccountDisplayEmail"></span>
                        </div>
                    </div>
                    <div class="small text-muted">
                        <i class="bi bi-info-circle me-1"></i>Hệ thống sẽ từ chối xóa nếu tài khoản này đã từng tạo hoặc chỉnh sửa bài viết trong hệ thống để bảo đảm toàn vẹn lịch sử.
                    </div>
                </div>
                <div class="modal-footer bg-light py-2 px-4">
                    <button type="button" class="btn btn-outline-secondary btn-sm px-3" data-bs-dismiss="modal" id="btnCancelDeleteModal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-danger btn-sm px-4" id="btnConfirmDeleteAccount">
                        <span class="spinner-border spinner-border-sm me-1 d-none" id="spinnerDeleteAccount" role="status" aria-hidden="true"></span>
                        <span id="btnTextDeleteAccount">Xác nhận xóa</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Toast thông báo thành công -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1080;">
    <div id="accountToast" class="toast align-items-center text-white bg-success border-0 shadow" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body">
                <i class="bi bi-check-circle-fill me-2 fs-6"></i>
                <span id="accountToastMsg">Thao tác thành công.</span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Anti-Forgery Token
            function getCsrfToken() {
                const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                return tokenInput ? tokenInput.value : '';
            }

            // Toast instance
            const toastEl = document.getElementById('accountToast');
            const toastMsg = document.getElementById('accountToastMsg');
            const toastInstance = toastEl ? new bootstrap.Toast(toastEl, { delay: 4000 }) : null;

            function showToast(message) {
                if (toastMsg) toastMsg.textContent = message;
                toastInstance?.show();
            }

            // Helper: Email validation
            const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;

            function setFieldError(inputEl, errorDivId, message) {
                if (inputEl) inputEl.classList.add('is-invalid');
                const errDiv = document.getElementById(errorDivId);
                if (errDiv) errDiv.textContent = message;
            }

            function clearFieldError(inputEl, errorDivId) {
                if (inputEl) inputEl.classList.remove('is-invalid');
            }

            function escapeHtml(text) {
                if (!text) return '';
                const map = {
                    '&': '&amp;',
                    '<': '&lt;',
                    '>': '&gt;',
                    '"': '&quot;',
                    "'": '&#039;'
                };
                return text.toString().replace(/[&<>"']/g, m => map[m]);
            }

            function renderRoleBadge(role, roleName) {
                if (role === 1) {
                    return `<span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1"><i class="bi bi-person-badge me-1"></i>Nhân viên</span>`;
                } else if (role === 2) {
                    return `<span class="badge bg-info-subtle text-info-emphasis border border-info-subtle px-2 py-1"><i class="bi bi-mortarboard me-1"></i>Giảng viên</span>`;
                }
                return `<span class="badge bg-secondary-subtle text-secondary border px-2 py-1">${escapeHtml(roleName || 'Không xác định')}</span>`;
            }

            // Lấy danh sách email hiện có trên bảng
            function getExistingEmails(excludeId = null) {
                const emails = new Set();
                document.querySelectorAll('#tableAccountsBody tr[data-account-email]').forEach(row => {
                    const rowId = row.getAttribute('data-account-id');
                    if (excludeId && rowId === String(excludeId)) {
                        return;
                    }
                    const em = row.getAttribute('data-account-email');
                    if (em) emails.add(em.trim().toLowerCase());
                });
                return emails;
            }

            // ==========================================
            // 1. TẠO MỚI TÀI KHOẢN (CREATE ACCOUNT)
            // ==========================================
            const formCreate = document.getElementById('formCreateAccount');
            const modalCreateEl = document.getElementById('modalCreateAccount');
            const modalCreateInstance = modalCreateEl ? new bootstrap.Modal(modalCreateEl) : null;

            const nameInput = document.getElementById('createAccountName');
            const emailInput = document.getElementById('createAccountEmail');
            const roleSelect = document.getElementById('createAccountRole');
            const passwordInput = document.getElementById('createAccountPassword');

            const alertBox = document.getElementById('createAccountAlert');
            const alertText = document.getElementById('createAccountAlertText');
            const submitBtn = document.getElementById('btnSubmitCreateAccount');
            const spinner = document.getElementById('spinnerCreateAccount');
            const btnText = document.getElementById('btnTextCreateAccount');

            modalCreateEl?.addEventListener('show.bs.modal', function () {
                [nameInput, emailInput, roleSelect, passwordInput].forEach(inp => inp && inp.classList.remove('is-invalid'));
                if (alertBox) alertBox.classList.add('d-none');
                formCreate?.reset();
            });

            emailInput?.addEventListener('blur', async function () {
                const emailVal = emailInput.value.trim().toLowerCase();
                if (!emailVal || emailInput.validity.typeMismatch) return;

                const existing = getExistingEmails();
                if (existing.has(emailVal)) {
                    setFieldError(emailInput, 'errorAccountEmail', 'Email này đã tồn tại trong danh sách tài khoản hệ thống.');
                    return;
                }

                try {
                    const resp = await fetch(`/admin/accounts?handler=CheckEmail&email=${encodeURIComponent(emailVal)}`, {
                        method: 'GET',
                        headers: { 'Accept': 'application/json' }
                    });
                    if (resp.ok) {
                        const data = await resp.json();
                        if (data.isDuplicate) {
                            setFieldError(emailInput, 'errorAccountEmail', 'Email này đã được sử dụng bởi một tài khoản khác trong hệ thống.');
                        } else {
                            clearFieldError(emailInput, 'errorAccountEmail');
                        }
                    }
                } catch {
                    // Ignore network error on blur
                }
            });

            nameInput?.addEventListener('input', () => clearFieldError(nameInput, 'errorAccountName'));
            emailInput?.addEventListener('input', () => clearFieldError(emailInput, 'errorAccountEmail'));
            roleSelect?.addEventListener('change', () => clearFieldError(roleSelect, 'errorAccountRole'));
            passwordInput?.addEventListener('input', () => clearFieldError(passwordInput, 'errorAccountPassword'));

            formCreate?.addEventListener('submit', async function (e) {
                e.preventDefault();
                [nameInput, emailInput, roleSelect, passwordInput].forEach(inp => inp && inp.classList.remove('is-invalid'));
                if (alertBox) alertBox.classList.add('d-none');

                let isValid = true;
                const nameVal = nameInput?.value.trim();
                if (!nameVal || nameVal.length > 100) {
                    setFieldError(nameInput, 'errorAccountName', 'Họ và tên là bắt buộc (tối đa 100 ký tự).');
                    isValid = false;
                }

                const emailVal = emailInput?.value.trim().toLowerCase();
                if (!emailVal || !emailRegex.test(emailVal) || emailVal.length > 70) {
                    setFieldError(emailInput, 'errorAccountEmail', 'Email không đúng định dạng hoặc vượt quá 70 ký tự.');
                    isValid = false;
                } else if (getExistingEmails().has(emailVal)) {
                    setFieldError(emailInput, 'errorAccountEmail', 'Email này đã tồn tại trong danh sách tài khoản hệ thống.');
                    isValid = false;
                }

                const roleVal = roleSelect?.value;
                if (!roleVal || (roleVal !== '1' && roleVal !== '2')) {
                    setFieldError(roleSelect, 'errorAccountRole', 'Vui lòng chọn vai trò: Nhân viên (1) hoặc Giảng viên (2).');
                    isValid = false;
                }

                const passVal = passwordInput?.value;
                if (!passVal || passVal.length < 6) {
                    setFieldError(passwordInput, 'errorAccountPassword', 'Mật khẩu phải có độ dài tối thiểu 6 ký tự.');
                    isValid = false;
                }

                if (!isValid) return;

                const payload = {
                    accountName: nameVal,
                    accountEmail: emailVal,
                    accountRole: parseInt(roleVal, 10),
                    accountPassword: passVal
                };

                if (submitBtn) submitBtn.disabled = true;
                if (spinner) spinner.classList.remove('d-none');
                if (btnText) btnText.textContent = 'Đang lưu...';

                try {
                    const response = await fetch('/admin/accounts?handler=Create', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-CSRF-TOKEN': getCsrfToken()
                        },
                        body: JSON.stringify(payload)
                    });

                    const result = await response.json();

                    if (result && result.success) {
                        modalCreateInstance?.hide();
                        formCreate.reset();
                        showToast(result.message || 'Tạo tài khoản thành công!');
                        insertAccountRow(result.account);

                        const badgeTotal = document.getElementById('badgeTotalCount');
                        if (badgeTotal) {
                            const curTotal = parseInt(badgeTotal.textContent, 10) || 0;
                            badgeTotal.textContent = (curTotal + 1).toString();
                        }
                    } else {
                        if (alertBox && alertText) {
                            alertText.textContent = result.message || 'Không thể tạo tài khoản. Vui lòng kiểm tra lại.';
                            alertBox.classList.remove('d-none');
                        }

                        if (result.errors) {
                            if (result.errors.AccountEmail || result.errors.accountEmail) {
                                setFieldError(emailInput, 'errorAccountEmail', (result.errors.AccountEmail || result.errors.accountEmail)[0]);
                            }
                            if (result.errors.AccountName || result.errors.accountName) {
                                setFieldError(nameInput, 'errorAccountName', (result.errors.AccountName || result.errors.accountName)[0]);
                            }
                            if (result.errors.AccountRole || result.errors.accountRole) {
                                setFieldError(roleSelect, 'errorAccountRole', (result.errors.AccountRole || result.errors.accountRole)[0]);
                            }
                            if (result.errors.AccountPassword || result.errors.accountPassword) {
                                setFieldError(passwordInput, 'errorAccountPassword', (result.errors.AccountPassword || result.errors.accountPassword)[0]);
                            }
                        }
                    }
                } catch {
                    if (alertBox && alertText) {
                        alertText.textContent = 'Lỗi kết nối máy chủ. Vui lòng thử lại sau.';
                        alertBox.classList.remove('d-none');
                    }
                } finally {
                    if (submitBtn) submitBtn.disabled = false;
                    if (spinner) spinner.classList.add('d-none');
                    if (btnText) btnText.textContent = 'Lưu tài khoản';
                }
            });

            // ==========================================
            // 2. CHỈNH SỬA TÀI KHOẢN (EDIT ACCOUNT)
            // ==========================================
            const formEdit = document.getElementById('formEditAccount');
            const modalEditEl = document.getElementById('modalEditAccount');
            const modalEditInstance = modalEditEl ? new bootstrap.Modal(modalEditEl) : null;

            const editIdInput = document.getElementById('editAccountId');
            const editNameInput = document.getElementById('editAccountName');
            const editEmailInput = document.getElementById('editAccountEmail');
            const editRoleSelect = document.getElementById('editAccountRole');

            const editAlertBox = document.getElementById('editAccountAlert');
            const editAlertText = document.getElementById('editAccountAlertText');
            const editSubmitBtn = document.getElementById('btnSubmitEditAccount');
            const editSpinner = document.getElementById('spinnerEditAccount');
            const editBtnText = document.getElementById('btnTextEditAccount');

            function resetEditValidation() {
                [editNameInput, editEmailInput, editRoleSelect].forEach(inp => inp && inp.classList.remove('is-invalid'));
                if (editAlertBox) editAlertBox.classList.add('d-none');
            }

            editNameInput?.addEventListener('input', () => clearFieldError(editNameInput, 'errorEditAccountName'));
            editEmailInput?.addEventListener('input', () => clearFieldError(editEmailInput, 'errorEditAccountEmail'));
            editRoleSelect?.addEventListener('change', () => clearFieldError(editRoleSelect, 'errorEditAccountRole'));

            editEmailInput?.addEventListener('blur', async function () {
                const emailVal = editEmailInput.value.trim().toLowerCase();
                const currentId = editIdInput ? editIdInput.value : '';
                if (!emailVal || editEmailInput.validity.typeMismatch) return;

                const existing = getExistingEmails(currentId);
                if (existing.has(emailVal)) {
                    setFieldError(editEmailInput, 'errorEditAccountEmail', 'Email này đã tồn tại trong danh sách tài khoản hệ thống.');
                    return;
                }

                try {
                    const resp = await fetch(`/admin/accounts?handler=CheckEmail&email=${encodeURIComponent(emailVal)}&excludeId=${currentId}`, {
                        method: 'GET',
                        headers: { 'Accept': 'application/json' }
                    });
                    if (resp.ok) {
                        const data = await resp.json();
                        if (data.isDuplicate) {
                            setFieldError(editEmailInput, 'errorEditAccountEmail', 'Email này đã được sử dụng bởi một tài khoản khác trong hệ thống.');
                        } else {
                            clearFieldError(editEmailInput, 'errorEditAccountEmail');
                        }
                    }
                } catch {
                    // Ignore network error on blur
                }
            });

            async function openEditModal(accountId, rowElement) {
                resetEditValidation();

                // Lấy thông tin từ data attributes của row
                let name = rowElement.getAttribute('data-account-name');
                let email = rowElement.getAttribute('data-account-email');
                let role = rowElement.getAttribute('data-account-role');

                if (editIdInput) editIdInput.value = accountId;
                if (editNameInput) editNameInput.value = name || '';
                if (editEmailInput) editEmailInput.value = email || '';
                if (editRoleSelect) editRoleSelect.value = role || '1';

                // Đồng thời fetch chi tiết từ server để đảm bảo dữ liệu mới nhất
                try {
                    const resp = await fetch(`/admin/accounts?handler=Account&id=${accountId}`, {
                        headers: { 'Accept': 'application/json' }
                    });
                    if (resp.ok) {
                        const data = await resp.json();
                        if (data.success && data.account) {
                            if (editNameInput) editNameInput.value = data.account.accountName || '';
                            if (editEmailInput) editEmailInput.value = data.account.accountEmail || '';
                            if (editRoleSelect) editRoleSelect.value = data.account.accountRole ? String(data.account.accountRole) : '1';
                        }
                    }
                } catch {
                    // Dùng fallback attributes nếu fetch thất bại
                }

                modalEditInstance?.show();
            }

            formEdit?.addEventListener('submit', async function (e) {
                e.preventDefault();
                resetEditValidation();

                let isValid = true;
                const idVal = parseInt(editIdInput.value, 10);
                const nameVal = editNameInput.value.trim();
                if (!nameVal || nameVal.length > 100) {
                    setFieldError(editNameInput, 'errorEditAccountName', 'Họ và tên là bắt buộc (tối đa 100 ký tự).');
                    isValid = false;
                }

                const emailVal = editEmailInput.value.trim().toLowerCase();
                if (!emailVal || !emailRegex.test(emailVal) || emailVal.length > 70) {
                    setFieldError(editEmailInput, 'errorEditAccountEmail', 'Email không đúng định dạng hoặc vượt quá 70 ký tự.');
                    isValid = false;
                } else if (getExistingEmails(idVal).has(emailVal)) {
                    setFieldError(editEmailInput, 'errorEditAccountEmail', 'Email này đã tồn tại trong danh sách tài khoản hệ thống.');
                    isValid = false;
                }

                const roleVal = editRoleSelect.value;
                if (!roleVal || (roleVal !== '1' && roleVal !== '2')) {
                    setFieldError(editRoleSelect, 'errorEditAccountRole', 'Vui lòng chọn vai trò: Nhân viên (1) hoặc Giảng viên (2).');
                    isValid = false;
                }

                if (!isValid) return;

                const payload = {
                    accountId: idVal,
                    accountName: nameVal,
                    accountEmail: emailVal,
                    accountRole: parseInt(roleVal, 10)
                };

                if (editSubmitBtn) editSubmitBtn.disabled = true;
                if (editSpinner) editSpinner.classList.remove('d-none');
                if (editBtnText) editBtnText.textContent = 'Đang lưu...';

                try {
                    const response = await fetch('/admin/accounts?handler=Update', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-CSRF-TOKEN': getCsrfToken()
                        },
                        body: JSON.stringify(payload)
                    });

                    const result = await response.json();

                    if (result && result.success) {
                        modalEditInstance?.hide();
                        showToast(result.message || 'Cập nhật tài khoản thành công!');
                        updateAccountRow(result.account);
                    } else {
                        // Thất bại: Giữ nguyên form để người dùng sửa
                        if (editAlertBox && editAlertText) {
                            editAlertText.textContent = result.message || 'Không thể cập nhật tài khoản. Vui lòng kiểm tra lại.';
                            editAlertBox.classList.remove('d-none');
                        }

                        if (result.errors) {
                            if (result.errors.AccountEmail || result.errors.accountEmail) {
                                setFieldError(editEmailInput, 'errorEditAccountEmail', (result.errors.AccountEmail || result.errors.accountEmail)[0]);
                            }
                            if (result.errors.AccountName || result.errors.accountName) {
                                setFieldError(editNameInput, 'errorEditAccountName', (result.errors.AccountName || result.errors.accountName)[0]);
                            }
                            if (result.errors.AccountRole || result.errors.accountRole) {
                                setFieldError(editRoleSelect, 'errorEditAccountRole', (result.errors.AccountRole || result.errors.accountRole)[0]);
                            }
                        }
                    }
                } catch {
                    if (editAlertBox && editAlertText) {
                        editAlertText.textContent = 'Lỗi kết nối máy chủ. Vui lòng thử lại sau.';
                        editAlertBox.classList.remove('d-none');
                    }
                } finally {
                    if (editSubmitBtn) editSubmitBtn.disabled = false;
                    if (editSpinner) editSpinner.classList.add('d-none');
                    if (editBtnText) editBtnText.textContent = 'Lưu thay đổi';
                }
            });

            // ==========================================
            // 3. XÓA TÀI KHOẢN (DELETE ACCOUNT)
            // ==========================================
            const modalDeleteEl = document.getElementById('modalDeleteAccount');
            const modalDeleteInstance = modalDeleteEl ? new bootstrap.Modal(modalDeleteEl) : null;
            const formDelete = document.getElementById('formDeleteAccount');
            const deleteIdInput = document.getElementById('deleteAccountId');

            const deleteDisplayId = document.getElementById('deleteAccountDisplayId');
            const deleteDisplayName = document.getElementById('deleteAccountDisplayName');
            const deleteDisplayEmail = document.getElementById('deleteAccountDisplayEmail');

            const deleteAlertBox = document.getElementById('deleteAccountAlert');
            const deleteAlertText = document.getElementById('deleteAccountAlertText');
            const deleteConfirmBtn = document.getElementById('btnConfirmDeleteAccount');
            const deleteSpinner = document.getElementById('spinnerDeleteAccount');
            const deleteBtnText = document.getElementById('btnTextDeleteAccount');

            let currentDeleteAccountId = null;

            function openDeleteModal(accountId, name, email) {
                currentDeleteAccountId = accountId;
                if (deleteIdInput) deleteIdInput.value = accountId;
                if (deleteDisplayId) deleteDisplayId.textContent = `#${accountId}`;
                if (deleteDisplayName) deleteDisplayName.textContent = name || '(Chưa có tên)';
                if (deleteDisplayEmail) deleteDisplayEmail.textContent = email || '';
                if (deleteAlertBox) deleteAlertBox.classList.add('d-none');

                modalDeleteInstance?.show();
            }

            async function executeDeleteAccount() {
                const targetId = currentDeleteAccountId || (deleteIdInput ? deleteIdInput.value : null);
                if (!targetId) return;

                if (deleteConfirmBtn) deleteConfirmBtn.disabled = true;
                if (deleteSpinner) deleteSpinner.classList.remove('d-none');
                if (deleteBtnText) deleteBtnText.textContent = 'Đang xóa...';

                try {
                    const formData = new FormData(formDelete || undefined);
                    if (!formData.has('id')) {
                        formData.append('id', targetId);
                    }

                    const csrfToken = getCsrfToken();
                    const response = await fetch(`/admin/accounts?handler=Delete&id=${encodeURIComponent(targetId)}`, {
                        method: 'POST',
                        headers: {
                            'X-CSRF-TOKEN': csrfToken
                        },
                        body: formData
                    });

                    const result = await response.json();

                    if (result && result.success) {
                        modalDeleteInstance?.hide();
                        showToast(result.message || 'Xóa tài khoản thành công!');
                        removeAccountRow(targetId);

                        const badgeTotal = document.getElementById('badgeTotalCount');
                        if (badgeTotal) {
                            const curTotal = parseInt(badgeTotal.textContent, 10) || 0;
                            badgeTotal.textContent = Math.max(0, curTotal - 1).toString();
                        }
                    } else {
                        // Thất bại (ví dụ tài khoản đã có bài viết -> 409 Conflict): Hiển thị thông báo ngay trong modal
                        if (deleteAlertBox && deleteAlertText) {
                            deleteAlertText.textContent = result.message || 'Không thể xóa tài khoản.';
                            deleteAlertBox.classList.remove('d-none');
                        }
                    }
                } catch {
                    if (deleteAlertBox && deleteAlertText) {
                        deleteAlertText.textContent = 'Lỗi kết nối máy chủ. Vui lòng thử lại sau.';
                        deleteAlertBox.classList.remove('d-none');
                    }
                } finally {
                    if (deleteConfirmBtn) deleteConfirmBtn.disabled = false;
                    if (deleteSpinner) deleteSpinner.classList.add('d-none');
                    if (deleteBtnText) deleteBtnText.textContent = 'Xác nhận xóa';
                }
            }

            formDelete?.addEventListener('submit', function (e) {
                e.preventDefault();
                executeDeleteAccount();
            });

            // ==========================================
            // 4. EVENT DELEGATION CHO NÚT THAO TÁC TRÊN BẢNG
            // ==========================================
            const tableBody = document.getElementById('tableAccountsBody');
            tableBody?.addEventListener('click', function (e) {
                const editBtn = e.target.closest('.btn-edit-account');
                if (editBtn) {
                    const row = editBtn.closest('tr');
                    const id = row.getAttribute('data-account-id');
                    openEditModal(id, row);
                    return;
                }

                const deleteBtn = e.target.closest('.btn-delete-account');
                if (deleteBtn) {
                    const row = deleteBtn.closest('tr');
                    const id = row.getAttribute('data-account-id');
                    const name = row.getAttribute('data-account-name') || '';
                    const email = row.getAttribute('data-account-email') || '';
                    openDeleteModal(id, name, email);
                    return;
                }
            });

            // ==========================================
            // 5. CẬP NHẬT GIAO DIỆN DOM
            // ==========================================
            function insertAccountRow(acc) {
                if (!acc) return;
                const tbody = document.getElementById('tableAccountsBody');
                if (!tbody) return;

                const emptyRow = document.getElementById('rowEmptyAccounts');
                if (emptyRow) emptyRow.remove();

                const roleBadge = renderRoleBadge(acc.accountRole, acc.roleName);

                const tr = document.createElement('tr');
                tr.id = `row-account-${acc.accountId}`;
                tr.setAttribute('data-account-id', acc.accountId);
                tr.setAttribute('data-account-name', acc.accountName);
                tr.setAttribute('data-account-email', acc.accountEmail);
                tr.setAttribute('data-account-role', acc.accountRole);
                tr.className = 'table-success-subtle transition-all';

                tr.innerHTML = `
                    <td class="text-center fw-semibold text-muted">${acc.accountId}</td>
                    <td><div class="fw-bold text-dark cell-account-name">${escapeHtml(acc.accountName)}</div></td>
                    <td><span class="text-body font-monospace small cell-account-email">${escapeHtml(acc.accountEmail)}</span></td>
                    <td class="cell-account-role">${roleBadge}</td>
                    <td class="text-center">
                        <div class="d-inline-flex gap-1">
                            <button type="button" class="btn btn-outline-primary btn-sm btn-edit-account" data-account-id="${acc.accountId}" title="Chỉnh sửa tài khoản">
                                <i class="bi bi-pencil me-1"></i>Sửa
                            </button>
                            <button type="button" class="btn btn-outline-danger btn-sm btn-delete-account" data-account-id="${acc.accountId}" title="Xóa tài khoản">
                                <i class="bi bi-trash me-1"></i>Xóa
                            </button>
                        </div>
                    </td>
                `;

                tbody.prepend(tr);

                setTimeout(() => {
                    tr.classList.remove('table-success-subtle');
                }, 2000);
            }

            function updateAccountRow(acc) {
                if (!acc) return;
                const row = document.getElementById(`row-account-${acc.accountId}`);
                if (!row) return;

                row.setAttribute('data-account-name', acc.accountName);
                row.setAttribute('data-account-email', acc.accountEmail);
                row.setAttribute('data-account-role', acc.accountRole);

                const nameCell = row.querySelector('.cell-account-name');
                if (nameCell) nameCell.textContent = acc.accountName;

                const emailCell = row.querySelector('.cell-account-email');
                if (emailCell) emailCell.textContent = acc.accountEmail;

                const roleCell = row.querySelector('.cell-account-role');
                if (roleCell) roleCell.innerHTML = renderRoleBadge(acc.accountRole, acc.roleName);

                row.classList.add('table-info-subtle');
                setTimeout(() => {
                    row.classList.remove('table-info-subtle');
                }, 2000);
            }

            function removeAccountRow(accountId) {
                const row = document.getElementById(`row-account-${accountId}`);
                if (!row) return;

                row.classList.add('table-danger-subtle');
                setTimeout(() => {
                    row.remove();

                    const tbody = document.getElementById('tableAccountsBody');
                    if (tbody && tbody.querySelectorAll('tr').length === 0) {
                        tbody.innerHTML = `
                            <tr id="rowEmptyAccounts">
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                    <span>Không tìm thấy tài khoản nào phù hợp với điều kiện tìm kiếm.</span>
                                </td>
                            </tr>
                        `;
                    }
                }, 300);
            }
        });
    </script>
}
