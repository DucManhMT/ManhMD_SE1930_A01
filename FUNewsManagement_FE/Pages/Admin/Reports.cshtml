@page "/admin/reports"
@model ManhMD_SE1930_A01_FE.Pages.Admin.ReportsModel
@{
    ViewData["Title"] = "Báo cáo thống kê tin tức";
}

<div class="container py-3 fu-container-public">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4 pb-2 border-bottom">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb small mb-1">
                    <li class="breadcrumb-item"><a asp-page="/Index" class="text-decoration-none">Trang chủ</a></li>
                    <li class="breadcrumb-item"><a href="/admin/accounts" class="text-decoration-none">Quản trị</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Báo cáo thống kê</li>
                </ol>
            </nav>
            <h1 class="h3 fw-bold text-dark mb-0">
                <i class="bi bi-graph-up-arrow text-primary me-2"></i>Báo cáo thống kê tin tức
            </h1>
            <p class="text-muted small mb-0 mt-1">
                Thống kê tổng hợp số lượng bài viết, tỷ lệ xuất bản và chi tiết lịch sử biên tập.
            </p>
        </div>
        <div>
            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 fw-semibold">
                <i class="bi bi-shield-lock me-1"></i>Quản trị viên (Admin)
            </span>
        </div>
    </div>

    <!-- Thông báo lỗi (nếu có) -->
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-warning alert-dismissible fade show d-flex align-items-center shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5 me-2 flex-shrink-0"></i>
            <div>@Model.ErrorMessage</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Form lọc khoảng thời gian và tiêu chí nhóm (AC 1, AC 2) -->
    <div class="card card-fu shadow-sm mb-4">
        <div class="card-header bg-light py-2 px-3 border-bottom">
            <span class="fw-semibold text-secondary small">
                <i class="bi bi-calendar-range me-1"></i>Thiết lập kỳ báo cáo
            </span>
        </div>
        <div class="card-body p-3 p-md-4">
            <form method="get" id="formReportFilter">
                <div class="row g-3 align-items-end">
                    <div class="col-12 col-sm-6 col-md-4">
                        <label for="inputStartDate" class="form-label small fw-semibold text-secondary mb-1">
                            <i class="bi bi-calendar-event me-1"></i>Từ ngày
                        </label>
                        <input type="date" class="form-control form-control-sm" id="inputStartDate" name="startDate"
                               value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" required />
                    </div>

                    <div class="col-12 col-sm-6 col-md-4">
                        <label for="inputEndDate" class="form-label small fw-semibold text-secondary mb-1">
                            <i class="bi bi-calendar-check me-1"></i>Đến ngày (tính hết ngày)
                        </label>
                        <input type="date" class="form-control form-control-sm" id="inputEndDate" name="endDate"
                               value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" required />
                    </div>

                    <div class="col-12 col-sm-6 col-md-2">
                        <label for="selectGroupBy" class="form-label small fw-semibold text-secondary mb-1">
                            <i class="bi bi-diagram-3 me-1"></i>Nhóm theo
                        </label>
                        <select class="form-select form-select-sm" id="selectGroupBy" name="groupBy">
                            <option value="category" selected="@(Model.GroupBy == "category")">Chuyên mục</option>
                            <option value="author" selected="@(Model.GroupBy == "author")">Tác giả</option>
                            <option value="status" selected="@(Model.GroupBy == "status")">Trạng thái</option>
                        </select>
                    </div>

                    <div class="col-12 col-sm-6 col-md-2 d-flex gap-2">
                        <button type="submit" class="btn btn-fu-primary btn-sm flex-fill" id="btnReportSubmit">
                            <i class="bi bi-filter me-1"></i>Xem báo cáo
                        </button>
                        <a href="/admin/reports" class="btn btn-outline-secondary btn-sm" title="Đặt lại về mặc định">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (Model.ReportData != null)
    {
        <!-- Summary Metric Cards (AC 3: Aggregate toàn tập) -->
        <div class="row g-3 mb-4">
            <div class="col-12 col-md-4">
                <div class="card card-fu shadow-sm p-3 border-start border-4 border-primary">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small fw-semibold text-uppercase">Tổng số bài viết</span>
                            <h2 class="display-6 fw-bold text-primary mb-0 mt-1" id="metricTotalArticles">
                                @Model.ReportData.TotalArticles
                            </h2>
                        </div>
                        <div class="bg-primary-subtle text-primary p-3 rounded-circle">
                            <i class="bi bi-newspaper fs-3"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-md-4">
                <div class="card card-fu shadow-sm p-3 border-start border-4 border-success">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small fw-semibold text-uppercase">Đang hiển thị (Active)</span>
                            <h2 class="display-6 fw-bold text-success mb-0 mt-1" id="metricTotalActive">
                                @Model.ReportData.TotalActive
                            </h2>
                        </div>
                        <div class="bg-success-subtle text-success p-3 rounded-circle">
                            <i class="bi bi-check-circle-fill fs-3"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-md-4">
                <div class="card card-fu shadow-sm p-3 border-start border-4 border-secondary">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small fw-semibold text-uppercase">Tạm ẩn (Inactive)</span>
                            <h2 class="display-6 fw-bold text-secondary mb-0 mt-1" id="metricTotalInactive">
                                @Model.ReportData.TotalInactive
                            </h2>
                        </div>
                        <div class="bg-secondary-subtle text-secondary p-3 rounded-circle">
                            <i class="bi bi-eye-slash-fill fs-3"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (Model.ReportData.TotalArticles == 0)
        {
            <div class="card card-fu shadow-sm p-5 text-center my-4">
                <div class="py-4">
                    <i class="bi bi-calendar-x text-muted display-4 d-block mb-3"></i>
                    <h3 class="h5 fw-bold text-secondary mb-2">Không có bài viết nào trong kỳ báo cáo</h3>
                    <p class="text-muted small mb-3">
                        Khoảng thời gian từ <strong>@(Model.StartDate?.ToString("dd/MM/yyyy"))</strong> đến <strong>@(Model.EndDate?.ToString("dd/MM/yyyy"))</strong> chưa ghi nhận bài viết mới nào.
                    </p>
                    <a href="/admin/reports" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-arrow-counterclockwise me-1"></i>Xem 30 ngày gần nhất
                    </a>
                </div>
            </div>
        }
        else
        {
            <!-- Section 1: Bảng tổng hợp theo nhóm (AC 3) -->
            <div class="card card-fu shadow-sm mb-4">
                <div class="card-header bg-light py-2 px-3 border-bottom d-flex justify-content-between align-items-center">
                    <span class="fw-semibold text-secondary small">
                        <i class="bi bi-pie-chart-fill me-1"></i>Bảng tổng hợp theo @(Model.GroupBy switch
                        {
                            "author" => "Tác giả",
                            "status" => "Trạng thái",
                            _ => "Chuyên mục"
                        })
                    </span>
                    <span class="badge bg-secondary-subtle text-secondary small">
                        @Model.ReportData.GroupSummaries.Count nhóm dữ liệu
                    </span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover table-striped align-middle mb-0" id="tableGroupSummaries">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>
                                    @(Model.GroupBy switch
                                    {
                                        "author" => "Tác giả",
                                        "status" => "Trạng thái xuất bản",
                                        _ => "Chuyên mục"
                                    })
                                </th>
                                <th class="text-center">Tổng số bài</th>
                                <th class="text-center">Đang hiển thị</th>
                                <th class="text-center">Tạm ẩn</th>
                                <th class="text-center">Tỷ lệ xuất bản</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int groupIndex = 1; }
                            @foreach (var g in Model.ReportData.GroupSummaries)
                            {
                                var rate = g.TotalCount > 0 ? (double)g.ActiveCount / g.TotalCount * 100 : 0;
                                <tr>
                                    <td class="text-muted small">@groupIndex</td>
                                    <td class="fw-semibold text-dark">@g.GroupName</td>
                                    <td class="text-center fw-bold">@g.TotalCount</td>
                                    <td class="text-center">
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                                            @g.ActiveCount
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                                            @g.InactiveCount
                                        </span>
                                    </td>
                                    <td class="text-center small">
                                        <div class="d-flex align-items-center justify-content-center gap-2">
                                            <div class="progress flex-grow-1" style="height: 6px; max-width: 80px;">
                                                <div class="progress-bar bg-success" role="progressbar" style="width: @(rate)%;" aria-valuenow="@rate" aria-valuemin="0" aria-valuemax="100"></div>
                                            </div>
                                            <span class="fw-medium">@rate.ToString("0.#")%</span>
                                        </div>
                                    </td>
                                </tr>
                                groupIndex++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Section 2: Bảng chi tiết từng bài viết (AC 4, AC 5) -->
            <div class="card card-fu shadow-sm mb-4">
                <div class="card-header bg-light py-2 px-3 border-bottom d-flex justify-content-between align-items-center">
                    <span class="fw-semibold text-secondary small">
                        <i class="bi bi-list-ul me-1"></i>Chi tiết danh sách bài viết trong kỳ (@Model.ReportData.Details.Count bài viết)
                    </span>
                    <span class="text-muted small">
                        Sắp xếp: Mới nhất trước (CreatedDate giảm dần)
                    </span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="tableReportDetails">
                        <thead class="table-light">
                            <tr>
                                <th>Mã bài</th>
                                <th>Tiêu đề & Tóm tắt</th>
                                <th>Chuyên mục</th>
                                <th>Tác giả</th>
                                <th>Ngày tạo</th>
                                <th>Trạng thái</th>
                                <th>Người sửa cuối</th>
                                <th>Ngày sửa cuối</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.ReportData.Details)
                            {
                                <tr>
                                    <td>
                                        <code class="text-secondary small">@item.NewsArticleId</code>
                                    </td>
                                    <td style="max-width: 320px;">
                                        <div class="fw-bold text-dark text-truncate" title="@item.NewsTitle">
                                            @item.NewsTitle
                                        </div>
                                        <div class="text-muted small text-truncate" title="@item.Headline">
                                            @item.Headline
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            @item.CategoryName
                                        </span>
                                    </td>
                                    <td class="small">
                                        <i class="bi bi-person me-1 text-muted"></i>@item.AuthorName
                                    </td>
                                    <td class="small text-nowrap">
                                        @(item.CreatedDate?.ToString("dd/MM/yyyy HH:mm") ?? "—")
                                    </td>
                                    <td>
                                        @if (item.NewsStatus == true)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                <i class="bi bi-check-circle me-1"></i>Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                                                <i class="bi bi-eye-slash me-1"></i>Inactive
                                            </span>
                                        }
                                    </td>
                                    <td class="small">
                                        @if (!string.IsNullOrWhiteSpace(item.LastEditorName) && item.LastEditorName != "Chưa chỉnh sửa")
                                        {
                                            <span class="text-dark fw-medium">
                                                <i class="bi bi-pencil-square me-1 text-primary"></i>@item.LastEditorName
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">Chưa chỉnh sửa</span>
                                        }
                                    </td>
                                    <td class="small text-muted text-nowrap">
                                        @(item.ModifiedDate?.ToString("dd/MM/yyyy HH:mm") ?? "—")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>
