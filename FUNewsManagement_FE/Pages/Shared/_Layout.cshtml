@inject FUNews.Client.DataAccess.Services.IOfflineStoreManager OfflineStore
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FUNews</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (OfflineStore.IsOffline)
    {
        <div id="offlineModeBanner" class="alert alert-warning text-center fw-bold py-2 mb-0 border-0 rounded-0 shadow-sm sticky-top" role="alert" style="z-index: 1050;">
            <i class="bi bi-wifi-off me-2"></i>⚠️ HỆ THỐNG ĐANG HOẠT ĐỘNG Ở CHẾ ĐỘ NGOẠI TUYẾN (OFFLINE MODE) — DỮ LIỆU ĐƯỢC TẢI TỪ BỘ NHỚ ĐỆM. CÁC TÍNH NĂNG THÊM, SỬA, XÓA TẠM THỜI BỊ KHÓA!
        </div>
    }
    <a href="#mainContent" class="skip-to-content">Bỏ qua đến nội dung chính</a>
    <header>
        <nav class="navbar navbar-expand-lg navbar-fu">
            <div class="container fu-container-public">
                @if (User.IsInRole("Admin"))
                {
                    <a class="navbar-brand navbar-brand-fu d-flex align-items-center" asp-page="/Index">
                        <span class="badge bg-danger me-2">Admin</span>
                        <span>FUNews</span>
                    </a>
                }
                else if (User.IsInRole("Staff"))
                {
                    <a class="navbar-brand navbar-brand-fu d-flex align-items-center" asp-page="/Index">
                        <span class="badge bg-primary me-2">Staff</span>
                        <span>FUNews</span>
                    </a>
                }
                else
                {
                    <a class="navbar-brand navbar-brand-fu" asp-page="/Index">FUNews</a>
                }

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain"
                        aria-expanded="false" aria-label="Chuyển đổi điều hướng">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/admin/dashboard">
                                    <i class="bi bi-speedometer2 me-1 text-primary"></i>Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/admin/accounts">Quản lý tài khoản</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/admin/auditlogs">
                                    <i class="bi bi-journal-text me-1 text-info"></i>Audit Log
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/admin/reports">Báo cáo lịch sử</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-muted" asp-page="/Index">Trang tin tức</a>
                            </li>
                        }
                        else if (User.IsInRole("Staff"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/news">Tin tức</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/search">Tìm kiếm</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/staff/news">Quản lý bài viết</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/staff/categories">Chuyên mục</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/staff/tags">Thẻ tin</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/staff/history">Lịch sử bài viết</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/staff/profile">Hồ sơ cá nhân</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/news">Tin tức</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/search">Tìm kiếm</a>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center flex-wrap gap-2">
                        <!-- Dropdown Thông Báo Thời Gian Thực (SignalR Bell) -->
                        <div class="dropdown me-1">
                            <button class="btn btn-outline-secondary btn-sm position-relative rounded-circle p-2 d-flex align-items-center justify-content-center" 
                                    type="button" 
                                    id="btnNotificationBell" 
                                    data-bs-toggle="dropdown" 
                                    aria-expanded="false" 
                                    title="Thông báo bài viết mới"
                                    style="width: 36px; height: 36px;">
                                <i class="bi bi-bell-fill fs-6"></i>
                                <span id="notificationCountBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none" style="font-size: 0.65rem;">
                                    0
                                    <span class="visually-hidden">thông báo mới</span>
                                </span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end shadow border-0 p-0" aria-labelledby="btnNotificationBell" style="width: 320px; max-width: 90vw;">
                                <div class="d-flex justify-content-between align-items-center p-3 bg-light border-bottom rounded-top">
                                    <span class="fw-bold small text-dark"><i class="bi bi-bell me-1 text-primary"></i>Thông Báo Mới</span>
                                    <button class="btn btn-link btn-sm p-0 text-decoration-none text-muted small" id="btnClearNotifications" title="Đánh dấu đã xem">
                                        Đã đọc
                                    </button>
                                </div>
                                <ul class="list-unstyled mb-0 overflow-auto" id="notificationDropdownList" style="max-height: 350px;">
                                    <!-- Render các item thông báo tại đây -->
                                </ul>
                                <div id="notificationEmptyNotice" class="text-center py-4 text-muted small">
                                    <i class="bi bi-chat-square-dots fs-3 d-block mb-1 text-muted opacity-50"></i>
                                    Chưa có thông báo bài viết mới nào.
                                </div>
                                <div class="p-2 bg-light text-center border-top rounded-bottom small text-muted">
                                    Lưu trữ tối đa 10 thông báo gần nhất
                                </div>
                            </div>
                        </div>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="d-flex align-items-center me-2 text-dark small">
                                <span>Xin chào, <strong class="ms-1">@User.Identity.Name</strong></span>
                                @if (User.IsInRole("Admin"))
                                {
                                    <span class="badge bg-danger ms-2">Quản trị viên</span>
                                }
                                else if (User.IsInRole("Staff"))
                                {
                                    <span class="badge bg-primary ms-2">Nhân viên</span>
                                }
                                else if (User.IsInRole("Lecturer"))
                                {
                                    <span class="badge bg-secondary ms-2">Giảng viên</span>
                                }
                            </div>
                            <button type="button" class="btn btn-outline-danger btn-sm" id="fuLogoutBtn" data-bs-toggle="modal" data-bs-target="#fuLogoutConfirmModal">
                                Đăng xuất
                            </button>
                        }
                        else
                        {
                            <a class="btn btn-outline-primary btn-sm" href="/search">Tìm kiếm</a>
                            <button type="button" class="btn btn-fu-primary btn-sm" data-bs-toggle="modal" data-bs-target="#fuLoginModal" id="fuNavLoginBtn">Đăng nhập</button>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    @{
        var isFluid = ViewData["UseFluidContainer"] as bool? == true;
    }
    <div class="@(isFluid ? "container-fluid px-3 px-lg-4" : "container fu-container-public") flex-grow-1 my-3">
        <main role="main" class="pb-3" id="mainContent">
            @RenderBody()
        </main>
    </div>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <!-- Modal xác nhận đăng xuất -->
        <div class="modal fade" id="fuLogoutConfirmModal" tabindex="-1" aria-labelledby="fuLogoutModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content card-fu">
                    <div class="modal-header border-bottom">
                        <h2 class="modal-title fs-5 fw-bold text-dark" id="fuLogoutModalLabel">Xác nhận đăng xuất</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                    </div>
                    <div class="modal-body py-4">
                        <p class="mb-0 text-muted">Bạn có chắc chắn muốn đăng xuất khỏi hệ thống <strong>FUNews</strong>?</p>
                    </div>
                    <div class="modal-footer border-top">
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Hủy bỏ</button>
                        <form method="post" asp-page="/Logout" class="d-inline m-0 p-0" id="fuLogoutForm">
                            <button type="submit" class="btn btn-danger btn-sm" id="fuLogoutConfirmSubmitBtn">Đăng xuất</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Modal Đăng nhập AJAX -->
        <div class="modal fade" id="fuLoginModal" tabindex="-1" aria-labelledby="fuLoginModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content card-fu">
                    <div class="modal-header border-bottom">
                        <h2 class="modal-title fs-5 fw-bold text-primary" id="fuLoginModalLabel">Đăng nhập tài khoản</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                    </div>
                    <form id="fuLoginModalForm" novalidate>
                        @Html.AntiForgeryToken()
                        <div class="modal-body p-4">
                            <div id="fuLoginModalAlert" class="alert alert-danger d-none py-2 px-3 small mb-3" role="alert" aria-live="assertive"></div>
                            
                            <div class="mb-3">
                                <label for="fuLoginModalEmail" class="form-label fw-semibold small">Địa chỉ Email <span class="text-danger">*</span></label>
                                <input type="email" class="form-control" id="fuLoginModalEmail" placeholder="name@FUNewsManagement.org" required autocomplete="username" />
                            </div>
                            <div class="mb-3">
                                <label for="fuLoginModalPassword" class="form-label fw-semibold small">Mật khẩu <span class="text-danger">*</span></label>
                                <input type="password" class="form-control" id="fuLoginModalPassword" placeholder="Nhập mật khẩu của bạn" required autocomplete="current-password" />
                            </div>
                            <div class="d-flex justify-content-between align-items-center text-muted small mt-2">
                                <span>Hỗ trợ Admin, Staff và Lecturer</span>
                                <a asp-page="/Login" class="text-primary text-decoration-none">Mở trang đầy đủ</a>
                            </div>
                        </div>
                        <div class="modal-footer border-top">
                            <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Hủy</button>
                            <button type="submit" class="btn btn-fu-primary btn-sm px-3" id="fuLoginModalSubmitBtn">
                                <span class="spinner-border spinner-border-sm me-1 d-none" id="fuLoginModalSpinner" role="status" aria-hidden="true"></span>
                                <span id="fuLoginModalBtnText">Đăng nhập</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }

    <!-- Toast container cho thông báo toàn hệ thống có aria-live -->
    @{
        var flashSuccess = TempData["SuccessMessage"]?.ToString();
        var flashError = TempData["ErrorMessage"]?.ToString();
    }
    <div class="toast-container position-fixed bottom-0 end-0 p-3" id="fuToastContainer" aria-live="polite" aria-atomic="true"
         data-server-success="@flashSuccess" data-server-error="@flashError"></div>

    <!-- Global Loading Overlay -->
    <div id="globalLoading" class="fu-loading-overlay d-none" role="status" aria-live="polite" aria-label="Đang xử lý">
        <div class="fu-loading-box">
            <div class="spinner-border mb-3" role="status">
                <span class="visually-hidden">Đang tải...</span>
            </div>
            <div class="fu-loading-text fw-semibold text-dark">Đang xử lý, vui lòng chờ...</div>
        </div>
    </div>

    <footer class="footer-fu">
        <div class="container fu-container-public text-center">
            &copy; 2026 - FUNews Management System - ManhMD (SE1930) - PRN232 Assignment 01
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (OfflineStore.IsOffline)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                var crudButtons = document.querySelectorAll(
                    'button[data-bs-target^="#modalCreate"], button[data-bs-target^="#modalEdit"], button[data-bs-target^="#modalDelete"], ' +
                    'button[data-bs-target*="Create"], button[data-bs-target*="Edit"], button[data-bs-target*="Delete"], ' +
                    '.btn-create-news, .btn-action-edit, .btn-action-delete, .btn-action-duplicate, .btn-duplicate'
                );

                crudButtons.forEach(function (btn) {
                    if (btn.classList.contains('btn-close') || btn.getAttribute('data-bs-dismiss') === 'modal') {
                        return;
                    }
                    btn.disabled = true;
                    btn.classList.add('disabled');
                    btn.setAttribute('title', 'Hệ thống đang ở chế độ ngoại tuyến (Offline Mode), tính năng bị khóa.');
                });

                document.querySelectorAll('form').forEach(function (form) {
                    if (form.getAttribute('method')?.toLowerCase() === 'post') {
                        form.addEventListener('submit', function (e) {
                            e.preventDefault();
                            e.stopPropagation();
                            if (window.showFuToast) {
                                window.showFuToast('Hệ thống đang ngoại tuyến, không thể thực hiện thao tác lưu dữ liệu.', 'warning');
                            } else {
                                alert('Hệ thống đang ngoại tuyến, không thể thực hiện thao tác lưu dữ liệu.');
                            }
                            return false;
                        });
                    }
                });
            });
        </script>
    }
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
    <script src="~/js/notification-client.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
